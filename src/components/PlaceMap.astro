---
type Props = {
  title: string;
  query: string;
  address?: string;
};

const { title, query, address } = Astro.props;
const encodedQuery = encodeURIComponent(query);
const embedUrl = `https://www.google.com/maps?q=${encodedQuery}&output=embed`;
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodedQuery}&utm_source=onearthtrip.com&utm_campaign=place_details_search`;
---

<section class="place-map" aria-label={`${title} 위치 지도`}>
  <div class="place-map-head">
    <div>
      <p class="eyebrow">LOCATION</p>
      <h2>{title} 위치</h2>
      {address && <p class="place-map-address">{address}</p>}
    </div>
    <a href={mapsUrl} target="_blank" rel="noopener noreferrer">Google Maps에서 열기 ↗</a>
  </div>
  <div class="place-map-frame">
    <iframe
      title={`${title} Google Maps`}
      src={embedUrl}
      width="100%"
      height="360"
      style="border:0"
      loading="lazy"
      allowfullscreen
      referrerpolicy="strict-origin-when-cross-origin"
    ></iframe>
  </div>
  <p class="place-map-note">지도 표시는 위치 이해를 돕기 위한 참고용입니다. 운영시간·입구·주차·도로 상황은 방문 당일 공식 안내와 현장 표지를 우선하세요.</p>
</section>

<style>
  .place-map {
    display: grid;
    gap: 14px;
    margin: 34px 0;
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 20px;
    background: var(--surface);
    box-shadow: var(--shadow-soft);
  }

  .place-map-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 18px;
  }

  .place-map-head h2,
  .place-map-head p {
    margin: 0;
  }

  .place-map-head a {
    flex: none;
    color: var(--accent-strong);
    font-size: 0.9rem;
    font-weight: 900;
  }

  .place-map-address {
    margin-top: 6px !important;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .place-map-frame {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface-muted);
  }

  .place-map-frame iframe {
    display: block;
    min-height: 300px;
  }

  .place-map-note {
    margin: 0;
    color: var(--soft);
    font-size: 0.82rem;
    line-height: 1.6;
  }

  @media (max-width: 640px) {
    .place-map {
      margin: 26px 0;
      padding: 14px;
    }

    .place-map-head {
      align-items: start;
      flex-direction: column;
      gap: 8px;
    }

    .place-map-frame iframe {
      height: 300px;
    }
  }
</style>
