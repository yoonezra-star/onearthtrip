---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { foodStoryPermalinks } from "../data/foodStories";
import { site } from "../data/site";
import { getPosts, getPublicPath } from "../utils/posts";

const posts = await getPosts();
const foodPosts = foodStoryPermalinks
  .map((permalink) => posts.find((post) => post.data.permalink === permalink))
  .filter((post): post is NonNullable<typeof post> => Boolean(post));

const pageName = "아부다비 음식·식비 가이드";
const pageDescription = "아부다비 하루 식비, Emirati 음식, 절약형 식사, 쇼핑몰 다이닝, 가족여행 식사 계획을 한곳에서 연결한 음식·식비 허브입니다.";
const pageUrl = new URL("/food-guide", site.url).toString();
const listId = `${pageUrl}#item-list`;
const itemListJson = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "@id": listId,
  name: "아부다비 음식·식비 가이드",
  numberOfItems: foodPosts.length,
  itemListElement: foodPosts.map((post, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: post.data.title,
    url: new URL(getPublicPath(post.data.permalink), site.url).toString()
  }))
};
const collectionJson = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${pageUrl}#webpage`,
  url: pageUrl,
  name: pageName,
  description: pageDescription,
  inLanguage: site.locale,
  isPartOf: { "@id": `${site.url}#website` },
  mainEntity: { "@id": listId },
  about: [
    { "@type": "Thing", name: "아부다비 음식" },
    { "@type": "Thing", name: "아부다비 식비" },
    { "@type": "Thing", name: "Emirati cuisine" },
    { "@type": "Thing", name: "Yas Mall" },
    { "@type": "Thing", name: "아부다비 가족여행" }
  ]
};
---

<BaseLayout
  title="아부다비 음식·식비 가이드 | 현지 음식·하루 예산 | On Earth Trip"
  description={pageDescription}
  canonical="/food-guide"
>
  <section class="page-hero">
    <div class="container page-hero-inner">
      <p class="eyebrow">FOOD &amp; DINING</p>
      <h1>아부다비에서 무엇을 먹고, 식비는 어떻게 잡을까</h1>
      <p class="lead">하루 식비 계산부터 Emirati 음식, 쇼핑몰 식사, 가족여행 끼니까지 여행 일정에 맞춰 고릅니다.</p>
      <p class="page-summary">{foodPosts.length}개 음식·식비 가이드</p>
      <div class="hero-actions">
        <a class="primary-link" href="/2026/08/abu-dhabi-daily-food-budget">하루 식비 계산</a>
        <a class="secondary-link" href="/2026/08/emirati-food-first-timer-guide">UAE 현지 음식 입문</a>
        <a class="secondary-link" href="/travel-costs">전체 여행예산</a>
      </div>
    </div>
  </section>

  <section class="section guide-path-section">
    <div class="container guide-path-grid">
      <a class="guide-path-card accent-teal" href="/2026/08/abu-dhabi-daily-food-budget">
        <span>01</span>
        <h2>하루 식비 계산</h2>
        <p>아침·점심·저녁, 호텔 식사, 세금·서비스비를 분리해 계산합니다.</p>
      </a>
      <a class="guide-path-card accent-date" href="/2026/08/emirati-food-first-timer-guide">
        <span>02</span>
        <h2>Emirati 음식 입문</h2>
        <p>Machboos, Chebab, Regag, Thareed, Luqaimat의 차이를 봅니다.</p>
      </a>
      <a class="guide-path-card accent-clay" href="/2026/08/abu-dhabi-budget-eating-guide">
        <span>03</span>
        <h2>식비 줄이기</h2>
        <p>쇼핑몰·슈퍼마켓·캐주얼 식당을 조합해 비싼 식사 횟수를 관리합니다.</p>
      </a>
      <a class="guide-path-card" href="/2026/08/abu-dhabi-mall-dining-guide">
        <span>04</span>
        <h2>쇼핑몰에서 먹기</h2>
        <p>Yas Mall과 The Galleria처럼 선택지가 많은 곳을 일정에 붙입니다.</p>
      </a>
      <a class="guide-path-card" href="/2026/08/abu-dhabi-family-meal-planning-guide">
        <span>05</span>
        <h2>아이와 식사 계획</h2>
        <p>테마파크·박물관·더운 날씨에 맞춰 식사와 휴식 시간을 배치합니다.</p>
      </a>
    </div>
  </section>

  <section class="section section-muted">
    <div class="container source-band">
      <div>
        <p class="eyebrow">HOW TO PLAN</p>
        <h2>식비는 교통비처럼 한 숫자로 고정하지 않습니다</h2>
      </div>
      <p>공식적으로 확인 가능한 세금·서비스비와 호텔 식사 참고 가격은 기준선으로 쓰고, 실제 끼니 가격은 예약일과 메뉴에 따라 마지막에 더합니다.</p>
      <div class="source-links">
        <a href="/travel-costs">여행예산 전체 계산</a>
        <a href="/where-to-stay">숙소 지역 선택</a>
        <a href="/2026/08/abu-dhabi-3-day-itinerary">3일 일정</a>
      </div>
    </div>
  </section>

  <section class="section" id="food-guides">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">FOOD CLUSTER</p>
          <h2>음식과 식비를 목적별로 보기</h2>
        </div>
        <p>특정 식당 순위보다 식사 유형, 지역, 가족여행과 예산 관리에 초점을 맞춘 가이드입니다.</p>
      </div>
      <div class="post-grid">
        {foodPosts.map((post) => <PostCard post={post} />)}
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(itemListJson)} />
  <script type="application/ld+json" set:html={JSON.stringify(collectionJson)} />
</BaseLayout>
