---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { coreStoryPermalinks } from "../data/coreStories";
import { getPosts } from "../utils/posts";

const posts = (await getPosts()).filter((post) => post.data.category === "나의 UAE 추억");
const corePosts = coreStoryPermalinks
  .map((permalink) => posts.find((post) => post.data.permalink === permalink))
  .filter((post): post is NonNullable<typeof post> => Boolean(post));

const getRecordYear = (post: (typeof posts)[number]) => {
  const years = post.data.fieldNote?.label
    ?.match(/(?:19|20)\d{2}/g)
    ?.map((value) => Number(value))
    .filter((value) => Number.isFinite(value));

  return years?.length ? Math.min(...years) : post.data.pubDate.getFullYear();
};

const recordYears = [...new Set(posts.map(getRecordYear))].sort((a, b) => b - a);
const uniquePosts = <T extends (typeof posts)[number]>(items: T[]) =>
  items.filter((post, index, all) => all.findIndex((item) => item.data.permalink === post.data.permalink) === index);
const featuredPosts = uniquePosts([...corePosts, ...posts]).slice(0, 6);
const photoRecords = posts.filter((post) => post.data.heroImage).length;
const firstYear = recordYears.length ? Math.min(...recordYears) : null;
const lastYear = recordYears.length ? Math.max(...recordYears) : null;
---

<BaseLayout
  title="나의 UAE 추억 | 직접 촬영·경험 아카이브 | On Earth Trip"
  description="UAE에서 직접 촬영하고 경험한 개인 기록을 대표 장면, 기록 연도, 사진·영상 색인으로 나눠 살펴보는 아카이브 입구입니다."
>
  <section class="page-hero">
    <div class="container page-hero-inner">
      <p class="eyebrow">UAE MEMORY ARCHIVE</p>
      <h1>나의 UAE 추억</h1>
      <p class="lead">
        오래 남은 장면을 모두 한 화면에 늘어놓기보다, 대표 기록과 실제 기록 연도를 먼저 보여 줍니다.
        운영 시간이나 가격 같은 현재 정보와는 분리된 개인 사진·영상·경험 아카이브입니다.
      </p>
      <p class="page-summary">
        {posts.length}개 추억 기록
        {firstYear && lastYear && <> · 기록 범위 {firstYear}~{lastYear}</>}
        {photoRecords > 0 && <> · 대표 이미지 {photoRecords}개 기록</>}
      </p>
      <div class="hero-actions">
        <a class="primary-link" href="/2026/08/uae-personal-photo-archive">2012~2022 개인 사진 색인</a>
        <a class="secondary-link" href="/field-notes">전체 연도별 현장 기록</a>
        <a class="secondary-link" href="/editorial-policy">사진·기록 원칙</a>
      </div>
    </div>
  </section>

  {recordYears.length > 0 && (
    <section class="section guide-path-section" aria-labelledby="memory-years-title">
      <div class="container">
        <div class="section-head">
          <div>
            <p class="eyebrow">BROWSE BY RECORD YEAR</p>
            <h2 id="memory-years-title">게시일이 아니라 실제 기록 시점으로 찾기</h2>
          </div>
          <p>각 글의 ‘기록 범위’에서 확인한 연도를 기준으로 전체 현장 기록 아카이브의 해당 연도로 이동합니다.</p>
        </div>
        <div class="source-links">
          {recordYears.map((year) => (
            <a href={`/field-notes#archive-${year}`}>{year}년 기록</a>
          ))}
        </div>
      </div>
    </section>
  )}

  {featuredPosts.length > 0 && (
    <section class="section section-muted">
      <div class="container">
        <div class="section-head">
          <div>
            <p class="eyebrow">FEATURED MEMORIES</p>
            <h2>먼저 볼 대표 추억 기록</h2>
          </div>
          <p>직접 촬영 증거와 기록 범위가 분명한 핵심 글을 우선 보여 줍니다. 전체 목록은 연도별 현장 기록에서 이어집니다.</p>
        </div>
        <div class="post-grid">
          {featuredPosts.map((post) => <PostCard post={post} />)}
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container guide-path-grid">
      <a class="guide-path-card accent-clay" href="/field-notes">
        <span>FULL ARCHIVE</span>
        <h2>연도별 현장 기록</h2>
        <p>촬영·경험 시점을 기준으로 모든 field-note를 연도별로 찾아봅니다.</p>
      </a>
      <a class="guide-path-card accent-date" href="/2026/08/uae-personal-photo-archive">
        <span>PHOTO &amp; VIDEO INDEX</span>
        <h2>개인 사진·영상 색인</h2>
        <p>2012~2022년 직접 촬영한 사진과 영상이 어떤 기록에 사용됐는지 한곳에서 확인합니다.</p>
      </a>
      <a class="guide-path-card accent-teal" href="/past-present-future">
        <span>TIME CONTEXT</span>
        <h2>과거와 현재를 구분해 읽기</h2>
        <p>오래된 사진을 현재 운영정보와 섞지 않고 과거·현재·미래의 근거 차이를 확인합니다.</p>
      </a>
      <a class="guide-path-card" href="/search">
        <span>SITE SEARCH</span>
        <h2>장소·주제로 검색</h2>
        <p>두바이, 사막, 해안, 호텔, 가족 생활처럼 기억나는 장소나 장면으로 기록을 찾습니다.</p>
      </a>
    </div>
  </section>

  <section class="section section-muted">
    <div class="container note-panel">
      <p class="eyebrow">MEMORY &amp; EVIDENCE</p>
      <h2>기억은 개인적이지만 기록 범위는 구체적으로 밝힙니다</h2>
      <p>
        이 아카이브는 작성자가 직접 경험하거나 촬영한 범위만 다룹니다. 정확한 장소·행사명이 원본 기록에 없으면 추정하지 않고,
        여러 날짜의 사진을 한 번의 방문처럼 합치지 않습니다. 오래된 사진에 보이는 시설·가격·동선은 현재 이용 안내의 근거로 사용하지 않습니다.
      </p>
      <a class="secondary-link" href="/author">운영자·작성자</a>
      <a class="secondary-link" href="/editorial-policy">사진·수정 원칙</a>
      <a class="secondary-link" href="/contact">오류·정정 제보</a>
    </div>
  </section>
</BaseLayout>
