---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { getPosts } from "../utils/posts";

const posts = (await getPosts()).filter((post) => post.data.category === "나의 UAE 추억");
---

<BaseLayout title="나의 UAE 추억 | On Earth Trip" description="아부다비와 UAE에서 오래 남은 순간, 감정, 장소의 기억을 담은 개인 기록입니다.">
  <section class="page-hero">
    <div class="container page-hero-inner">
      <p class="eyebrow">UAE MEMORY</p>
      <h1>나의 UAE 추억</h1>
      <p class="lead">정보보다 오래 남는 것은 한 장면입니다. 그 장면들을 천천히 기록합니다.</p>
      <p class="page-summary">{posts.length}개의 추억 기록을 모았습니다.</p>
      <div class="hero-actions">
        <a class="primary-link" href="/2026/08/uae-personal-photo-archive">2012~2022 개인 사진 색인</a>
        <a class="secondary-link" href="/field-notes">기록 연도별 현장 기록 보기</a>
      </div>
    </div>
  </section>
  <section class="section section-muted">
    <div class="container note-panel">
      <p class="eyebrow">MEMORY &amp; EVIDENCE</p>
      <h2>오래된 사진은 현재 정보와 구분해 읽습니다</h2>
      <p>
        이 페이지의 글은 사진 촬영일과 작성자가 직접 경험한 범위를 먼저 밝힙니다. 정확한 장소나 행사명이
        원본 기록에 없으면 추정하지 않으며, 운영 시간·가격·시설 상태처럼 달라질 수 있는 내용은 현재의 이용
        안내로 제공하지 않습니다.
      </p>
      <a class="secondary-link" href="/reading-guide">기록 읽는 법</a>
      <a class="secondary-link" href="/editorial-policy">사진·수정 원칙</a>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="post-grid">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    </div>
  </section>
</BaseLayout>
