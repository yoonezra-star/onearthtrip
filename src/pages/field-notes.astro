---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { getCategoryPath, getPosts, getPublicPath } from "../utils/posts";
import { site } from "../data/site";

const fieldNotes = (await getPosts())
  .filter((post) => post.data.contentType === "field-note")
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const getRecordYear = (post: (typeof fieldNotes)[number]) => {
  const years = post.data.fieldNote?.label
    .match(/(?:19|20)\d{2}/g)
    ?.map((value) => Number(value))
    .filter((value) => Number.isFinite(value));

  return years?.length ? Math.min(...years) : post.data.pubDate.getFullYear();
};

const years = [...new Set(fieldNotes.map(getRecordYear))].sort((a, b) => b - a);
const groups = years.map((year) => ({
  year,
  posts: fieldNotes.filter((post) => getRecordYear(post) === year)
}));
const categoryGroups = [...new Set(fieldNotes.map((post) => post.data.category))]
  .map((category) => ({
    category,
    href: getCategoryPath(category),
    count: fieldNotes.filter((post) => post.data.category === category).length
  }))
  .sort((a, b) => b.count - a.count || a.category.localeCompare(b.category, "ko"));
const photoRecords = fieldNotes.filter((post) => post.data.heroImage).length;
const videoRecords = fieldNotes.filter((post) => (post.body ?? "").includes("<video")).length;
const listJson = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "UAE 현장 기록 아카이브",
  numberOfItems: fieldNotes.length,
  itemListElement: fieldNotes.map((post, index) => ({
    "@type": "ListItem",
    position: index + 1,
    url: new URL(getPublicPath(post.data.permalink), site.url).toString(),
    name: post.data.title
  }))
};
---

<BaseLayout
  title="UAE 현장 기록 아카이브 | On Earth Trip"
  description="아부다비와 UAE에서 직접 보고 촬영한 생활·문화·여행 기록을 실제 기록 시점 기준으로 모은 사진·영상 아카이브입니다."
>
  <section class="page-hero">
    <div class="container page-hero-inner">
      <p class="eyebrow">FIELD NOTE ARCHIVE</p>
      <h1>UAE 현장 기록 아카이브</h1>
      <p class="lead">
        직접 경험한 장소와 생활 장면을 실제 기록 시점 기준으로 모았습니다. 오래된 기록은 현재 정보처럼 포장하지 않고,
        당시의 날짜와 경험 범위를 함께 표시합니다.
      </p>
      <div class="hero-actions">
        <a class="primary-link" href="/2026/08/uae-personal-photo-archive">2012~2022 개인 사진 색인 보기</a>
        <a class="secondary-link" href="/reading-guide">정보 글과 현장 기록 구분법</a>
      </div>
      <div class="archive-summary" aria-label="아카이브 현황">
        <span><strong>{fieldNotes.length}</strong>개 현장 기록</span>
        <span><strong>{photoRecords}</strong>개 대표 사진 기록</span>
        <span><strong>{videoRecords}</strong>개 영상 포함 기록</span>
      </div>
    </div>
  </section>

  <section class="section archive-intro-section">
    <div class="container source-band">
      <div>
        <p class="eyebrow">HOW TO READ</p>
        <h2>게시 날짜보다 촬영·경험 시점을 기준으로 봅니다</h2>
      </div>
      <p>
        각 글의 ‘기록 범위’에 적힌 연도를 우선해 목록을 묶습니다. 여러 해가 함께 적힌 기록은 가장 이른 기록연도에 배치하고,
        연도가 확인되지 않는 경우에만 게시 연도를 사용합니다. 운영 시간·가격·연락처처럼 바뀔 수 있는 정보는 현재 이용 안내로
        간주하지 않으며, 필요한 경우 공식 출처를 별도로 확인합니다.
      </p>
      <div class="source-links">
        <a href="/editorial-policy">사진·영상 사용 원칙</a>
        <a href="/2026/08/uae-personal-photo-archive">전체 개인 사진 색인</a>
      </div>
    </div>
  </section>

  <section class="section guide-path-section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">BROWSE BY THEME</p>
          <h2>주제별 현장 기록 보기</h2>
        </div>
        <p>같은 연도 안에서도 생활·문화·추억의 성격이 다릅니다. 관심 있는 주제의 전체 글 목록으로 이동할 수 있습니다.</p>
      </div>
      <div class="guide-path-grid">
        {categoryGroups.map((group) => (
          <a class="guide-path-card" href={group.href}>
            <span>{group.count} FIELD NOTES</span>
            <div>
              <h2>{group.category}</h2>
              <p>{group.category}에 속한 현장 기록과 관련 가이드를 함께 봅니다.</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-muted">
    <div class="container archive-timeline">
      {groups.map((group) => (
        <section class="archive-year" aria-labelledby={`archive-${group.year}`}>
          <header class="archive-year-head">
            <p class="eyebrow">RECORD YEAR</p>
            <h2 id={`archive-${group.year}`}>{group.year}년</h2>
            <p>{group.posts.length}개의 기록</p>
          </header>
          <div class="post-grid">
            {group.posts.map((post) => <PostCard post={post} />)}
          </div>
        </section>
      ))}
    </div>
  </section>
  <script type="application/ld+json" set:html={JSON.stringify(listJson)} />
</BaseLayout>
