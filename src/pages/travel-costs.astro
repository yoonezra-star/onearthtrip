---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { costStoryPermalinks } from "../data/costStories";
import { site } from "../data/site";
import { getPosts, getPublicPath } from "../utils/posts";

const posts = await getPosts();
const costPosts = costStoryPermalinks
  .map((permalink) => posts.find((post) => post.data.permalink === permalink))
  .filter((post): post is NonNullable<typeof post> => Boolean(post));

const pageName = "아부다비 교통비·여행예산 가이드";
const pageDescription = "공항→도심, 도심↔Yas·Saadiyat 교통비와 3일·5일 여행예산을 현재 공식 요금 기준으로 계산하는 비용 허브입니다.";
const pageUrl = new URL("/travel-costs", site.url).toString();
const listId = `${pageUrl}#item-list`;
const itemListJson = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "@id": listId,
  name: "아부다비 여행 비용 가이드",
  numberOfItems: costPosts.length,
  itemListElement: costPosts.map((post, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: post.data.title,
    url: new URL(getPublicPath(post.data.permalink), site.url).toString()
  }))
};
const collectionJson = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${pageUrl}#webpage`,
  url: pageUrl,
  name: pageName,
  description: pageDescription,
  inLanguage: site.locale,
  isPartOf: { "@id": `${site.url}#website` },
  mainEntity: { "@id": listId },
  about: [
    { "@type": "Thing", name: "아부다비 교통비" },
    { "@type": "Thing", name: "아부다비 여행 예산" },
    { "@type": "Thing", name: "아부다비 식비" },
    { "@type": "Thing", name: "Hafilat" },
    { "@type": "Thing", name: "Yas Island" },
    { "@type": "Thing", name: "Saadiyat Island" }
  ]
};
---

<BaseLayout
  title="아부다비 교통비·여행예산 | 버스·택시·3일·5일 | On Earth Trip"
  description={pageDescription}
  canonical="/travel-costs"
>
  <section class="page-hero">
    <div class="container page-hero-inner">
      <p class="eyebrow">TRAVEL COSTS</p>
      <h1>아부다비 여행비용, 교통비부터 고정하면 계산이 쉬워집니다</h1>
      <p class="lead">버스·택시처럼 공식 요금이 있는 항목을 먼저 계산하고 숙박·식비·입장권은 실제 예약 가격으로 더합니다.</p>
      <p class="page-summary">{costPosts.length}개 비용 계산 가이드</p>
      <div class="hero-actions">
        <a class="primary-link" href="/2026/08/abu-dhabi-3-day-travel-budget">3일 예산</a>
        <a class="secondary-link" href="/2026/08/abu-dhabi-5-day-travel-budget">5일 예산</a>
        <a class="secondary-link" href="/food-guide">음식·식비 계산</a>
        <a class="secondary-link" href="/where-to-stay">숙소 지역 비교</a>
      </div>
    </div>
  </section>

  <section class="section guide-path-section">
    <div class="container guide-path-grid">
      <a class="guide-path-card accent-teal" href="/2026/08/abu-dhabi-airport-city-transport-cost">
        <span>01</span>
        <h2>공항 → 도심</h2>
        <p>공항버스와 공식 공항택시 비용을 공식 요금표로 계산합니다.</p>
      </a>
      <a class="guide-path-card accent-clay" href="/2026/08/downtown-yas-island-transport-cost">
        <span>02</span>
        <h2>도심 ↔ Yas Island</h2>
        <p>버스·택시와 섬 안 무료 Yas Express를 나눠 계산합니다.</p>
      </a>
      <a class="guide-path-card accent-date" href="/2026/08/downtown-saadiyat-transport-cost">
        <span>03</span>
        <h2>도심 ↔ Saadiyat</h2>
        <p>박물관 일정에 맞춰 버스·택시·Abu Dhabi Link를 비교합니다.</p>
      </a>
      <a class="guide-path-card" href="/2026/08/abu-dhabi-3-day-travel-budget">
        <span>04</span>
        <h2>3일 여행 예산</h2>
        <p>Hafilat와 택시를 먼저 계산하고 숙박·식비·티켓을 더합니다.</p>
      </a>
      <a class="guide-path-card" href="/2026/08/abu-dhabi-5-day-travel-budget">
        <span>05</span>
        <h2>5일 여행 예산</h2>
        <p>7일 교통 패스와 pay-as-you-go를 비교해 이동비를 정합니다.</p>
      </a>
      <a class="guide-path-card accent-date" href="/food-guide">
        <span>06</span>
        <h2>음식·식비</h2>
        <p>하루 식비, 현지 음식, 쇼핑몰 식사와 가족여행 끼니를 별도로 계산합니다.</p>
      </a>
    </div>
  </section>

  <section class="section section-muted">
    <div class="container source-band">
      <div>
        <p class="eyebrow">COST METHOD</p>
        <h2>확정 가능한 숫자와 변동 가격을 분리합니다</h2>
      </div>
      <p>공식 버스·택시 요금은 계산식으로 고정하고, 호텔·식비·테마파크처럼 날짜에 따라 달라지는 가격은 실제 예약 화면에서 마지막에 더합니다.</p>
      <div class="source-links">
        <a href="/where-to-stay">숙소 지역 선택</a>
        <a href="/food-guide">음식·식비 계획</a>
        <a href="/2026/08/abu-dhabi-3-day-itinerary">3일 일정</a>
        <a href="/attractions">관광지 선택</a>
      </div>
    </div>
  </section>

  <section class="section" id="cost-guides">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">COST CLUSTER</p>
          <h2>구간별·여행기간별 비용 계산하기</h2>
        </div>
        <p>고정된 평균값을 복사하지 않고 현재 공식 요금과 실제 일정에 맞춰 계산하도록 구성했습니다.</p>
      </div>
      <div class="post-grid">
        {costPosts.map((post) => <PostCard post={post} />)}
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(itemListJson)} />
  <script type="application/ld+json" set:html={JSON.stringify(collectionJson)} />
</BaseLayout>
