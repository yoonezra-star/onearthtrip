---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { alAinStoryPermalinks } from "../data/alAinStories";
import { site } from "../data/site";
import { getPosts, getPublicPath } from "../utils/posts";

const posts = await getPosts();
const alAinPosts = alAinStoryPermalinks
  .map((permalink) => posts.find((post) => post.data.permalink === permalink))
  .filter((post): post is NonNullable<typeof post> => Boolean(post));

const pageName = "아부다비↔알아인 이동·당일치기 가이드";
const pageDescription = "아부다비↔알아인 시외버스와 렌터카 이동, Al Ain Oasis, Jebel Hafeet, 알아인 하루 일정을 한곳에서 연결한 여행 허브입니다.";
const pageUrl = new URL("/al-ain-guide", site.url).toString();
const listId = `${pageUrl}#item-list`;
const itemListJson = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "@id": listId,
  name: "알아인 이동·관광 가이드",
  numberOfItems: alAinPosts.length,
  itemListElement: alAinPosts.map((post, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: post.data.title,
    url: new URL(getPublicPath(post.data.permalink), site.url).toString()
  }))
};
const collectionJson = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${pageUrl}#webpage`,
  url: pageUrl,
  name: pageName,
  description: pageDescription,
  inLanguage: site.locale,
  isPartOf: { "@id": `${site.url}#website` },
  mainEntity: { "@id": listId },
  about: [
    { "@type": "Place", name: "Al Ain" },
    { "@type": "Thing", name: "Al Ain intercity bus" },
    { "@type": "Place", name: "Al Ain Oasis" },
    { "@type": "Place", name: "Jebel Hafeet" },
    { "@type": "Thing", name: "Al Ain day trip" }
  ]
};
---

<BaseLayout
  title="알아인 당일치기 가이드 | 버스·렌터카·오아시스·Jebel Hafeet | On Earth Trip"
  description={pageDescription}
  canonical="/al-ain-guide"
>
  <section class="page-hero">
    <div class="container page-hero-inner">
      <p class="eyebrow">AL AIN DAY TRIP</p>
      <h1>알아인 당일치기, 이동수단과 마지막 전망 시간을 함께 정합니다</h1>
      <p class="lead">아부다비에서 약 90분 떨어진 알아인을 버스·렌터카로 이동하고, 오아시스와 Jebel Hafeet을 한 날에 어떻게 묶을지 정리합니다.</p>
      <p class="page-summary">{alAinPosts.length}개 알아인 이동·관광 가이드</p>
      <div class="hero-actions">
        <a class="primary-link" href="/intercity-guide">도시 간 이동 비교</a>
        <a class="secondary-link" href="/driving-guide">렌터카·운전 준비</a>
        <a class="secondary-link" href="/travel-apps-guide">지도·교통 앱</a>
      </div>
    </div>
  </section>

  <section class="section guide-path-section">
    <div class="container guide-path-grid">
      <div class="guide-path-card accent-teal">
        <span>01</span>
        <h2>아부다비에서 이동</h2>
        <p>시외버스와 렌터카의 시간·비용·현지 이동 자유도를 먼저 비교합니다.</p>
      </div>
      <div class="guide-path-card accent-date">
        <span>02</span>
        <h2>Al Ain Oasis</h2>
        <p>UNESCO 문화유산의 팜 그로브와 falaj 관개 시스템을 여유 있게 걷습니다.</p>
      </div>
      <div class="guide-path-card accent-clay">
        <span>03</span>
        <h2>Jebel Hafeet</h2>
        <p>산 정상 전망은 날씨와 일몰 시각을 확인하고 하루 일정의 마지막에 배치합니다.</p>
      </div>
    </div>
  </section>

  <section class="section section-muted">
    <div class="container source-band">
      <div>
        <p class="eyebrow">PLAN BY TRANSPORT</p>
        <h2>버스 여행과 렌터카 여행은 같은 일정으로 만들지 않습니다</h2>
      </div>
      <p>시외버스는 비용 예측이 쉽지만 알아인 도착 후 현지 이동을 다시 계산해야 합니다. 렌터카는 오아시스와 Jebel Hafeet을 연결하기 쉽지만 주차·연료·운전 조건까지 함께 확인해야 합니다.</p>
      <div class="source-links">
        <a href="/intercity-guide">아부다비 도시 간 이동</a>
        <a href="/driving-guide">렌터카·운전</a>
        <a href="/travel-costs">교통비·여행예산</a>
        <a href="/2026/08/uae-seven-emirates-slow-travel">UAE 지역 여행 흐름</a>
      </div>
    </div>
  </section>

  <section class="section" id="al-ain-guides">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">AL AIN CLUSTER</p>
          <h2>알아인 이동과 주요 장소를 한 번에 보기</h2>
        </div>
        <p>Abu Dhabi Mobility와 Experience Abu Dhabi의 최신 공개 정보를 기준으로, 변동 가능한 운행시간·현장 운영정보는 방문 직전에 다시 확인하도록 구성했습니다.</p>
      </div>
      <div class="post-grid">
        {alAinPosts.map((post) => <PostCard post={post} />)}
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(itemListJson)} />
  <script type="application/ld+json" set:html={JSON.stringify(collectionJson)} />
</BaseLayout>
