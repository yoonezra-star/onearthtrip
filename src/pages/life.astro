---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { coreStoryPermalinks } from "../data/coreStories";
import { getPosts, getPublicPath } from "../utils/posts";

const posts = (await getPosts()).filter((post) => post.data.category === "아부다비 한인 생활");
const fieldNotes = posts.filter((post) => post.data.contentType === "field-note");
const guides = posts.filter((post) => post.data.contentType !== "field-note");
const corePosts = coreStoryPermalinks
  .map((permalink) => posts.find((post) => post.data.permalink === permalink))
  .filter((post): post is NonNullable<typeof post> => Boolean(post));

const featuredLifePermalinks = [
  "/2026/08/abu-dhabi-first-30-days.html",
  "/2026/08/zayed-international-airport-to-abu-dhabi-city.html",
  "/2026/08/abu-dhabi-public-transport-guide.html",
  "/2026/08/abu-dhabi-3-day-itinerary.html",
  "/2026/08/abu-dhabi-where-to-stay-area-guide.html",
  "/2026/08/abu-dhabi-travel-data-usage-guide.html"
] as const;

const featuredGuides = featuredLifePermalinks
  .map((permalink) => guides.find((post) => post.data.permalink === permalink))
  .filter((post): post is NonNullable<typeof post> => Boolean(post));
const recentFieldNotes = fieldNotes.slice(0, 6);
---

<BaseLayout
  title="아부다비 한인 생활·여행 준비 | On Earth Trip"
  description="아부다비 도착, 교통, 숙소, 여행예산, 일정과 현지 생활을 대표 가이드와 직접 경험 기록으로 나눠 찾기 쉽게 정리한 생활 허브입니다."
>
  <section class="page-hero">
    <div class="container page-hero-inner">
      <p class="eyebrow">KOREAN LIFE IN ABU DHABI</p>
      <h1>아부다비 한인 생활·여행 준비</h1>
      <p class="lead">처음 도착하는 날부터 숙소·교통·예산·일정과 현지 생활까지, 필요한 순서대로 읽을 수 있게 핵심 경로만 먼저 보여 줍니다.</p>
      <p class="page-summary">{guides.length}개 생활·여행 가이드 · {fieldNotes.length}개 직접 경험 기록</p>
      <div class="hero-actions" aria-label="생활 허브 주요 이동">
        <a class="primary-link" href="#start-here">먼저 볼 5개 경로</a>
        <a class="secondary-link" href="#featured-guides">대표 가이드</a>
        {recentFieldNotes.length > 0 && <a class="secondary-link" href="#field-notes">직접 경험 기록</a>}
      </div>
    </div>
  </section>

  <section class="section guide-path-section" id="start-here">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">START HERE</p>
          <h2>목적에 맞는 생활·여행 경로부터 고르기</h2>
        </div>
        <p>모든 글을 한꺼번에 펼치지 않고, 지금 해결하려는 문제에 맞는 전문 허브로 먼저 연결합니다.</p>
      </div>
      <div class="guide-path-grid">
        <a class="guide-path-card accent-teal" href="/trip-checklist">
          <span>01</span>
          <h2>도착 전·공항 첫날</h2>
          <p>입국 준비, 공항에서 도심 이동, 유심·eSIM과 첫날 필요한 순서를 확인합니다.</p>
        </a>
        <a class="guide-path-card accent-teal" href="/where-to-stay">
          <span>02</span>
          <h2>숙소·비용·결제</h2>
          <p>Corniche·Yas·Saadiyat 숙소 지역과 이동비, AED 환전·카드·ATM을 함께 봅니다.</p>
        </a>
        <a class="guide-path-card accent-date" href="/attractions">
          <span>03</span>
          <h2>일정·관광지</h2>
          <p>3일·5일 여행과 Downtown·Saadiyat·Yas 관광지를 지역별로 조합합니다.</p>
        </a>
        <a class="guide-path-card accent-teal" href="/driving-guide">
          <span>04</span>
          <h2>운전·도시 간 이동</h2>
          <p>렌터카·주차·통행료와 두바이·알아인 등 도심 밖 이동을 따로 계획합니다.</p>
        </a>
        <a class="guide-path-card accent-date" href="/food-guide">
          <span>05</span>
          <h2>식사·쇼핑·생활</h2>
          <p>현지 식비와 가족 식사, 쇼핑·VAT 환급까지 체류 중 실제 소비 흐름을 정리합니다.</p>
        </a>
      </div>
      <div class="source-band">
        <div>
          <p class="eyebrow">SPECIALIZED HUBS</p>
          <h2>더 구체적인 문제는 전문 허브에서 이어서 보기</h2>
        </div>
        <div class="source-links">
          <a href="/connectivity-guide">유심·eSIM·인터넷</a>
          <a href="/travel-apps-guide">여행 앱·지도</a>
          <a href="/travel-costs">교통비·여행예산</a>
          <a href="/money-guide">환전·결제</a>
          <a href="/shopping-guide">쇼핑·VAT 환급</a>
          <a href="/intercity-guide">아부다비↔두바이 이동</a>
          <a href="/al-ain-guide">알아인 당일치기</a>
          <a href="/reading-guide">전체 읽기 길잡이</a>
        </div>
      </div>
    </div>
  </section>

  {corePosts.length > 0 && (
    <section class="section section-muted">
      <div class="container source-band">
        <div>
          <p class="eyebrow">CORE LIFE GUIDES</p>
          <h2>처음 아부다비를 준비할 때 먼저 읽을 핵심 글</h2>
        </div>
        <p>도착·공항 이동·대중교통·생활 적응처럼 처음 방문하거나 체류를 시작할 때 필요한 기준 글입니다.</p>
        <div class="source-links">
          {corePosts.map((post) => <a href={getPublicPath(post.data.permalink)}>{post.data.title}</a>)}
        </div>
      </div>
    </section>
  )}

  {featuredGuides.length > 0 && (
    <section class="section" id="featured-guides">
      <div class="container">
        <div class="section-head">
          <div>
            <p class="eyebrow">FEATURED PRACTICAL GUIDES</p>
            <h2>대표 생활·여행 가이드</h2>
          </div>
          <p>전체 글을 나열하는 대신 도착, 이동, 일정, 숙소와 인터넷처럼 자주 필요한 대표 가이드만 먼저 보여 줍니다.</p>
        </div>
        <div class="post-grid">
          {featuredGuides.map((post) => <PostCard post={post} />)}
        </div>
      </div>
    </section>
  )}

  {recentFieldNotes.length > 0 && (
    <section class="section section-muted" id="field-notes">
      <div class="container">
        <div class="section-head">
          <div>
            <p class="eyebrow">FIRST-HAND LIFE RECORDS</p>
            <h2>직접 살며 남긴 최근 생활 현장 기록</h2>
          </div>
          <p>사진과 당시 경험을 바탕으로 한 기록입니다. 현재 규정이나 시설 안내와 섞지 않고 각 글의 기록 시점과 범위를 따로 표시합니다.</p>
        </div>
        <div class="post-grid">
          {recentFieldNotes.map((post) => <PostCard post={post} />)}
        </div>
        <div class="hero-actions">
          <a class="primary-link" href="/field-notes">전체 직접 촬영 기록 보기</a>
          <a class="secondary-link" href="/2026/08/uae-personal-photo-archive">2012~2022 개인 사진 아카이브</a>
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container note-panel">
      <p class="eyebrow">SCOPE</p>
      <h2>현재 실용정보와 개인 경험은 따로 읽습니다</h2>
      <p>
        공항·교통·운영시간·요금처럼 바뀔 수 있는 내용은 공식 안내와 확인 날짜를 우선합니다. 직접 촬영한 생활 기록은
        당시 경험의 범위를 보여 주는 자료이며, 현재 규정이나 가격을 대신하지 않습니다.
      </p>
      <a class="secondary-link" href="/editorial-policy">작성·수정 원칙</a>
      <a class="secondary-link" href="/search">사이트 전체 검색</a>
    </div>
  </section>
</BaseLayout>
