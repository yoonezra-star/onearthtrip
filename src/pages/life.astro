---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { coreStoryPermalinks } from "../data/coreStories";
import { planningStoryPermalinks } from "../data/planningStories";
import { getPosts, getPublicPath } from "../utils/posts";

const posts = (await getPosts()).filter((post) => post.data.category === "아부다비 한인 생활");
const fieldNotes = posts.filter((post) => post.data.contentType === "field-note");
const guides = posts.filter((post) => post.data.contentType !== "field-note");
const corePosts = coreStoryPermalinks
  .map((permalink) => posts.find((post) => post.data.permalink === permalink))
  .filter((post): post is NonNullable<typeof post> => Boolean(post));
const planningPosts = planningStoryPermalinks
  .map((permalink) => posts.find((post) => post.data.permalink === permalink))
  .filter((post): post is NonNullable<typeof post> => Boolean(post));
---

<BaseLayout
  title="아부다비 한인 생활·여행 준비 | On Earth Trip"
  description="아부다비 도착, 공항·대중교통, 3일·5일 일정, Yas Island, 여름 가족여행과 현지 생활 기록을 가이드와 현장 기록으로 나눠 정리합니다."
>
  <section class="page-hero">
    <div class="container page-hero-inner">
      <p class="eyebrow">KOREAN LIFE IN ABU DHABI</p>
      <h1>아부다비 한인 생활·여행 준비</h1>
      <p class="lead">한국에서 온 뒤 아부다비에서 마주하는 이동, 더위, 생활 리듬과 여행 동선을 실제 준비 순서에 맞춰 정리합니다.</p>
      <p class="page-summary">{fieldNotes.length}개 현장 기록 · {guides.length}개 생활·여행 가이드</p>
      <div class="hero-actions" aria-label="콘텐츠 유형별 이동">
        {planningPosts.length > 0 && <a class="primary-link" href="#travel-planning">여행 일정부터 보기</a>}
        {fieldNotes.length > 0 && <a class="secondary-link" href="#field-notes">직접 경험 현장 기록</a>}
        <a class="secondary-link" href="#all-guides">전체 생활 가이드</a>
      </div>
    </div>
  </section>

  {corePosts.length > 0 && (
    <section class="section">
      <div class="container source-band">
        <div>
          <p class="eyebrow">CORE LIFE GUIDES</p>
          <h2>아부다비 생활에서 먼저 읽을 핵심 글</h2>
        </div>
        <p>입국, 공항 이동, 대중교통, 도시 간 이동처럼 처음 도착했을 때 바로 필요한 핵심 가이드를 우선 연결합니다.</p>
        <div class="source-links">
          {corePosts.map((post) => <a href={getPublicPath(post.data.permalink)}>{post.data.title}</a>)}
        </div>
      </div>
    </section>
  )}

  {planningPosts.length > 0 && (
    <section class="section section-muted" id="travel-planning">
      <div class="container">
        <div class="section-head">
          <div>
            <p class="eyebrow">TRAVEL PLANNING</p>
            <h2>아부다비 일정·지역별 여행 계획</h2>
          </div>
          <p>3일·5일 전체 일정과 Yas Island, 가족·여름 실내여행을 별도 가이드로 나눠 필요한 일정만 골라 볼 수 있습니다.</p>
        </div>
        <div class="post-grid">
          {planningPosts.map((post) => <PostCard post={post} />)}
        </div>
        <div class="hero-actions">
          <a class="secondary-link" href="/reading-guide">UAE 여행 읽기 길잡이</a>
          <a class="secondary-link" href="/2026/08/saadiyat-downtown-planning-guide">Saadiyat 문화 일정 보기</a>
        </div>
      </div>
    </section>
  )}

  {fieldNotes.length > 0 && (
    <section class="section" id="field-notes">
      <div class="container">
        <div class="section-head">
          <div>
            <p class="eyebrow">FIRST-HAND LIFE RECORDS</p>
            <h2>직접 살며 남긴 생활 현장 기록</h2>
          </div>
          <p>사진과 당시 경험을 바탕으로 한 기록입니다. 현재 규정이나 시설 안내와는 구분해 각 글의 기록 범위를 함께 표시합니다.</p>
        </div>
        <div class="post-grid">
          {fieldNotes.map((post) => <PostCard post={post} />)}
        </div>
      </div>
    </section>
  )}

  <section class="section section-muted">
    <div class="container note-panel">
      <p class="eyebrow">SCOPE</p>
      <h2>경험과 현재 여행 정보를 구분해 읽습니다</h2>
      <p>
        장보기와 식사, 계절별 생활 리듬, 이동, 가족 방문객을 맞이하는 동선처럼 한국에서 온 사람이 실제로
        선택하게 되는 생활의 장면을 다룹니다. 현장 기록은 당시 경험의 범위를 보여 주고, 입국·교통·운영 시간처럼
        바뀔 수 있는 정보는 현재 공식 안내와 확인 날짜를 함께 봅니다.
      </p>
      <a class="secondary-link" href="/trip-checklist">여행 준비 체크</a>
      <a class="secondary-link" href="/editorial-policy">작성·수정 원칙</a>
    </div>
  </section>

  {guides.length > 0 && (
    <section class="section" id="all-guides">
      <div class="container">
        <div class="section-head">
          <div>
            <p class="eyebrow">ALL LIFE &amp; TRAVEL GUIDES</p>
            <h2>아부다비 생활·여행 가이드 전체</h2>
          </div>
          <p>새로 추가되는 글이 특정 하드코딩 목록에서 빠지지 않도록 생활 카테고리의 모든 가이드를 자동으로 보여 줍니다.</p>
        </div>
        <div class="post-grid">
          {guides.map((post) => <PostCard post={post} />)}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
