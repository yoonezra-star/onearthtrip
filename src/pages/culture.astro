---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { getPosts } from "../utils/posts";

const posts = (await getPosts()).filter((post) => post.data.category === "UAE 문화");
const fieldNotes = posts.filter((post) => post.data.contentType === "field-note");
const guides = posts.filter((post) => post.data.contentType !== "field-note");
---

<BaseLayout title="UAE 문화 | On Earth Trip" description="라마단, 마즐리스, 대추야자, 향, 차 문화처럼 UAE 생활 속 문화를 경험 기록과 확인 가이드로 나눠 정리합니다.">
  <section class="page-hero">
    <div class="container page-hero-inner">
      <p class="eyebrow">UAE CULTURE</p>
      <h1>UAE 문화</h1>
      <p class="lead">사람을 대하는 방식, 환대의 언어, 계절의 냄새처럼 문화가 생활이 되는 순간들.</p>
      <p class="page-summary">{fieldNotes.length}개 현장 기록 · {guides.length}개 문화 가이드</p>
      <div class="hero-actions" aria-label="콘텐츠 유형별 이동">
        {fieldNotes.length > 0 && <a class="primary-link" href="#field-notes">직접 본 문화 현장</a>}
        {guides.length > 0 && <a class="secondary-link" href="#guides">문화 가이드</a>}
        <a class="secondary-link" href="/field-notes">전체 UAE 현장 기록</a>
      </div>
    </div>
  </section>

  {fieldNotes.length > 0 && (
    <section class="section" id="field-notes">
      <div class="container">
        <div class="section-head">
          <div>
            <p class="eyebrow">FIRST-HAND CULTURE RECORDS</p>
            <h2>직접 보고 촬영한 문화 현장 기록</h2>
          </div>
          <p>한 번의 행사나 방문을 UAE 문화 전체로 일반화하지 않고, 촬영 시점과 확인 가능한 장면의 범위를 함께 남깁니다.</p>
        </div>
        <div class="post-grid">
          {fieldNotes.map((post) => <PostCard post={post} />)}
        </div>
      </div>
    </section>
  )}

  <section class="section section-muted">
    <div class="container source-band">
      <div>
        <p class="eyebrow">HOW WE RECORD CULTURE</p>
        <h2>경험 기록과 현재 방문 정보를 구분합니다</h2>
      </div>
      <p>
        개인이 경험한 자리와 오래된 사진은 시기·장소·관찰 범위를 함께 밝힙니다. 문화적 의미는 확인 가능한
        자료와 구분하고, 복장·촬영·입장처럼 달라질 수 있는 규정은 현재 운영 주체의 안내를 우선합니다.
      </p>
      <div class="source-links">
        <a href="/field-notes">기록 연도별 현장 기록</a>
        <a href="/2026/08/uae-culture-etiquette-first-visit">문화 공간 방문 준비</a>
        <a href="/editorial-policy">작성·수정 원칙</a>
      </div>
    </div>
  </section>

  {guides.length > 0 && (
    <section class="section" id="guides">
      <div class="container">
        <div class="section-head">
          <div>
            <p class="eyebrow">CULTURE GUIDES</p>
            <h2>현재 방문과 이해를 위한 문화 가이드</h2>
          </div>
          <p>현장 사진의 기억과 분리해, 방문 준비와 문화적 맥락을 현재 기준으로 확인할 수 있는 글입니다.</p>
        </div>
        <div class="post-grid">
          {guides.map((post) => <PostCard post={post} />)}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
