---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { attractionStoryPermalinks } from "../data/attractionStories";
import { downtownStoryPermalinks } from "../data/downtownStories";
import { site } from "../data/site";
import { getPosts, getPublicPath } from "../utils/posts";

const posts = await getPosts();
const attractionPosts = attractionStoryPermalinks
  .map((permalink) => posts.find((post) => post.data.permalink === permalink))
  .filter((post): post is NonNullable<typeof post> => Boolean(post));
const downtownPosts = downtownStoryPermalinks
  .map((permalink) => posts.find((post) => post.data.permalink === permalink))
  .filter((post): post is NonNullable<typeof post> => Boolean(post));
const allAttractions = [...downtownPosts, ...attractionPosts];

const pageName = "아부다비 관광지 가이드";
const pageDescription = "아부다비 도심의 Qasr Al Watan·Corniche, Saadiyat 박물관, Yas Island 테마파크를 지역과 여행 목적별로 고르는 관광지 허브입니다.";
const pageUrl = new URL("/attractions", site.url).toString();
const listId = `${pageUrl}#item-list`;
const itemListJson = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "@id": listId,
  name: "아부다비 관광지 방문 가이드",
  numberOfItems: allAttractions.length,
  itemListElement: allAttractions.map((post, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: post.data.title,
    url: new URL(getPublicPath(post.data.permalink), site.url).toString()
  }))
};
const collectionJson = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${pageUrl}#webpage`,
  url: pageUrl,
  name: pageName,
  description: pageDescription,
  inLanguage: site.locale,
  isPartOf: { "@id": `${site.url}#website` },
  mainEntity: { "@id": listId },
  about: [
    { "@type": "Thing", name: "아부다비 관광지" },
    { "@type": "Thing", name: "Downtown Abu Dhabi" },
    { "@type": "Thing", name: "Saadiyat Cultural District" },
    { "@type": "Thing", name: "Yas Island" }
  ]
};
---

<BaseLayout
  title="아부다비 관광지 가이드 | Downtown·Saadiyat·Yas | On Earth Trip"
  description={pageDescription}
  canonical="/attractions"
>
  <section class="page-hero">
    <div class="container page-hero-inner">
      <p class="eyebrow">ABU DHABI ATTRACTIONS</p>
      <h1>아부다비 관광지, 지역부터 나누면 일정이 쉬워집니다</h1>
      <p class="lead">도심의 역사·궁전·해안, Saadiyat의 박물관, Yas Island의 테마파크를 한 목록에 섞지 않고 지역별로 선택합니다.</p>
      <p class="page-summary">{allAttractions.length}개 현재형 관광지 가이드</p>
      <div class="hero-actions">
        <a class="primary-link" href="/downtown-attractions">도심 관광지</a>
        <a class="secondary-link" href="/2026/08/saadiyat-downtown-planning-guide">Saadiyat 일정</a>
        <a class="secondary-link" href="/2026/08/yas-island-planning-guide">Yas Island 일정</a>
      </div>
    </div>
  </section>

  <section class="section guide-path-section">
    <div class="container guide-path-grid">
      <a class="guide-path-card accent-teal" href="/downtown-attractions">
        <span>01</span>
        <h2>Downtown Abu Dhabi</h2>
        <p>Qasr Al Hosn, Qasr Al Watan, Emirates Palace, Corniche와 Heritage Village를 묶습니다.</p>
      </a>
      <a class="guide-path-card accent-date" href="/2026/08/saadiyat-downtown-planning-guide">
        <span>02</span>
        <h2>Saadiyat Cultural District</h2>
        <p>루브르, 자이드 국립박물관, 자연사박물관과 teamLab을 고릅니다.</p>
      </a>
      <a class="guide-path-card accent-clay" href="/2026/08/yas-island-planning-guide">
        <span>03</span>
        <h2>Yas Island</h2>
        <p>Ferrari World, Warner Bros., SeaWorld, Yas Waterworld 중 목적에 맞게 선택합니다.</p>
      </a>
    </div>
  </section>

  <section class="section section-muted">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">DOWNTOWN CLUSTER</p>
          <h2>아부다비 도심 관광지</h2>
        </div>
        <p>역사 건축물과 대통령궁, 호텔 건축, 해안 산책을 같은 도심권에서 연결합니다.</p>
      </div>
      <div class="post-grid">
        {downtownPosts.map((post) => <PostCard post={post} />)}
      </div>
    </div>
  </section>

  <section class="section" id="guides">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">SAADIYAT &amp; YAS</p>
          <h2>박물관과 테마파크 관광지</h2>
        </div>
        <p>Saadiyat 문화시설과 Yas Island 테마파크는 운영시간·티켓·입장 조건을 공식 페이지 기준으로 확인합니다.</p>
      </div>
      <div class="post-grid">
        {attractionPosts.map((post) => <PostCard post={post} />)}
      </div>
      <div class="hero-actions">
        <a class="primary-link" href="/2026/08/abu-dhabi-3-day-itinerary">3일 일정 보기</a>
        <a class="secondary-link" href="/2026/08/abu-dhabi-5-day-itinerary">5일 일정 보기</a>
        <a class="secondary-link" href="/reading-guide">전체 읽기 길잡이</a>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(collectionJson)} />
  <script type="application/ld+json" set:html={JSON.stringify(itemListJson)} />
</BaseLayout>
