---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { moneyStoryPermalinks } from "../data/moneyStories";
import { site } from "../data/site";
import { getPosts, getPublicPath } from "../utils/posts";

const posts = await getPosts();
const moneyPosts = moneyStoryPermalinks
  .map((permalink) => posts.find((post) => post.data.permalink === permalink))
  .filter((post): post is NonNullable<typeof post> => Boolean(post));

const pageName = "아부다비 환전·결제·돈 사용 가이드";
const pageDescription = "아부다비 현금·카드 결제, AED 환전, 자이드 국제공항 환전·ATM, 해외카드 출금, 팁·서비스비를 한곳에서 연결한 여행 돈 사용 허브입니다.";
const pageUrl = new URL("/money-guide", site.url).toString();
const listId = `${pageUrl}#item-list`;
const itemListJson = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "@id": listId,
  name: "아부다비 환전·결제 가이드",
  numberOfItems: moneyPosts.length,
  itemListElement: moneyPosts.map((post, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: post.data.title,
    url: new URL(getPublicPath(post.data.permalink), site.url).toString()
  }))
};
const collectionJson = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${pageUrl}#webpage`,
  url: pageUrl,
  name: pageName,
  description: pageDescription,
  inLanguage: site.locale,
  isPartOf: { "@id": `${site.url}#website` },
  mainEntity: { "@id": listId },
  about: [
    { "@type": "Thing", name: "UAE dirham" },
    { "@type": "Thing", name: "아부다비 카드 결제" },
    { "@type": "Thing", name: "AED 환전" },
    { "@type": "Thing", name: "아부다비 ATM" },
    { "@type": "Thing", name: "아부다비 팁" },
    { "@type": "Thing", name: "UAE VAT refund" }
  ]
};
---

<BaseLayout
  title="아부다비 환전·결제 가이드 | AED·카드·ATM·팁 | On Earth Trip"
  description={pageDescription}
  canonical="/money-guide"
>
  <section class="page-hero">
    <div class="container page-hero-inner">
      <p class="eyebrow">MONEY &amp; PAYMENTS</p>
      <h1>아부다비 여행 돈 사용, 현금과 카드를 어떻게 나눌까</h1>
      <p class="lead">AED 환전부터 카드 결제, 공항 환전·ATM, 팁과 서비스비까지 실제 여행 순서대로 확인합니다.</p>
      <p class="page-summary">{moneyPosts.length}개 환전·결제 가이드</p>
      <div class="hero-actions">
        <a class="primary-link" href="/2026/08/abu-dhabi-cash-card-payment-guide">현금·카드부터 보기</a>
        <a class="secondary-link" href="/2026/08/aed-exchange-guide">AED 환전</a>
        <a class="secondary-link" href="/shopping-guide">쇼핑·VAT 환급</a>
        <a class="secondary-link" href="/travel-costs">여행예산 계산</a>
      </div>
    </div>
  </section>

  <section class="section guide-path-section">
    <div class="container guide-path-grid">
      <a class="guide-path-card accent-teal" href="/2026/08/abu-dhabi-cash-card-payment-guide">
        <span>01</span>
        <h2>현금·카드 비중</h2>
        <p>카드를 기본으로 쓰고 소액 현금을 어디에 준비할지 정합니다.</p>
      </a>
      <a class="guide-path-card accent-date" href="/2026/08/aed-exchange-guide">
        <span>02</span>
        <h2>AED 환전</h2>
        <p>USD 고정환율과 환전소·은행·호텔 환전의 차이를 봅니다.</p>
      </a>
      <a class="guide-path-card accent-clay" href="/2026/08/zayed-airport-exchange-atm-guide">
        <span>03</span>
        <h2>공항에서 AED 준비</h2>
        <p>자이드 국제공항 환전 창구와 ATM을 도착 직후 비교합니다.</p>
      </a>
      <a class="guide-path-card" href="/2026/08/abu-dhabi-atm-withdrawal-guide">
        <span>04</span>
        <h2>ATM 출금</h2>
        <p>해외카드 수수료·한도·보안을 확인하고 필요한 만큼 인출합니다.</p>
      </a>
      <a class="guide-path-card" href="/2026/08/abu-dhabi-tipping-service-charge-guide">
        <span>05</span>
        <h2>팁·서비스비</h2>
        <p>팁 의무 여부와 식당 영수증의 서비스비를 구분합니다.</p>
      </a>
      <a class="guide-path-card accent-date" href="/shopping-guide">
        <span>06</span>
        <h2>쇼핑·VAT 환급</h2>
        <p>결제 뒤 관광객 VAT 환급이 필요한 구매는 별도 절차로 이어서 확인합니다.</p>
      </a>
    </div>
  </section>

  <section class="section section-muted">
    <div class="container source-band">
      <div>
        <p class="eyebrow">HOW TO USE MONEY</p>
        <h2>큰 현금보다 결제수단을 분산합니다</h2>
      </div>
      <p>주결제 카드, 예비 카드, 소액 AED 현금을 나눠 준비하고 숙소·교통·식비·쇼핑처럼 큰 예산은 항목별로 따로 관리하는 편이 안전합니다.</p>
      <div class="source-links">
        <a href="/travel-costs">교통비·여행예산</a>
        <a href="/food-guide">음식·식비</a>
        <a href="/shopping-guide">쇼핑·VAT 환급</a>
        <a href="/where-to-stay">숙소 지역</a>
      </div>
    </div>
  </section>

  <section class="section" id="money-guides">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">MONEY CLUSTER</p>
          <h2>환전·결제를 상황별로 보기</h2>
        </div>
        <p>환율 숫자 하나보다 실제 결제 상황, 카드사의 해외 이용 조건과 공식 현지 안내를 함께 확인하도록 구성했습니다.</p>
      </div>
      <div class="post-grid">
        {moneyPosts.map((post) => <PostCard post={post} />)}
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(itemListJson)} />
  <script type="application/ld+json" set:html={JSON.stringify(collectionJson)} />
</BaseLayout>
