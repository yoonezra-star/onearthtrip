---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { sirBaniYasStoryPermalinks } from "../data/sirBaniYasStories";
import { site } from "../data/site";
import { getPosts, getPublicPath } from "../utils/posts";

const posts = await getPosts();
const sirBaniYasPosts = sirBaniYasStoryPermalinks
  .map((permalink) => posts.find((post) => post.data.permalink === permalink))
  .filter((post): post is NonNullable<typeof post> => Boolean(post));
const fieldNote = posts.find((post) => post.data.permalink === "/2021/06/sir-bani-yas-coastal-road-2021.html");

const pageName = "Sir Bani Yas Island·Al Dhafra 해안 여행 가이드";
const pageDescription = "아부다비에서 Sir Bani Yas Island로 가는 법, Jebel Dhanna 보트, Arabian Wildlife Park, 1박 일정과 Al Dhafra 해안 여행을 한곳에서 연결한 허브입니다.";
const pageUrl = new URL("/sir-bani-yas-guide", site.url).toString();
const listId = `${pageUrl}#item-list`;
const itemListJson = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "@id": listId,
  name: "Sir Bani Yas Island 여행 가이드",
  numberOfItems: sirBaniYasPosts.length,
  itemListElement: sirBaniYasPosts.map((post, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: post.data.title,
    url: new URL(getPublicPath(post.data.permalink), site.url).toString()
  }))
};
const collectionJson = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${pageUrl}#webpage`,
  url: pageUrl,
  name: pageName,
  description: pageDescription,
  inLanguage: site.locale,
  isPartOf: { "@id": `${site.url}#website` },
  mainEntity: { "@id": listId },
  about: [
    { "@type": "Place", name: "Sir Bani Yas Island" },
    { "@type": "Place", name: "Jebel Dhanna" },
    { "@type": "Place", name: "Arabian Wildlife Park" },
    { "@type": "Place", name: "Al Dhafra" },
    { "@type": "Thing", name: "Sir Bani Yas wildlife safari" }
  ]
};
---

<BaseLayout
  title="Sir Bani Yas Island 가이드 | 보트·사파리·1박 일정 | On Earth Trip"
  description={pageDescription}
  canonical="/sir-bani-yas-guide"
>
  <section class="page-hero">
    <div class="container page-hero-inner">
      <p class="eyebrow">SIR BANI YAS · AL DHAFRA COAST</p>
      <h1>Sir Bani Yas는 섬에 들어가기 전, Jebel Dhanna 이동부터 계획합니다</h1>
      <p class="lead">아부다비 서부 해안까지의 장거리 이동, 보트 예약, Arabian Wildlife Park와 1박 체류를 현재 정보와 2021년 직접 촬영 기록으로 구분해 봅니다.</p>
      <p class="page-summary">{sirBaniYasPosts.length}개 현재 여행 가이드 · {fieldNote ? "1개 직접 촬영 기록" : "현장 기록 연결"}</p>
      <div class="hero-actions">
        <a class="primary-link" href="/2026/08/sir-bani-yas-island-getting-there-guide">섬 가는 법</a>
        <a class="secondary-link" href="/2026/08/sir-bani-yas-wildlife-safari-guide">Wildlife Safari</a>
        <a class="secondary-link" href="/2026/08/sir-bani-yas-island-overnight-itinerary">1박 일정</a>
      </div>
    </div>
  </section>

  <section class="section guide-path-section">
    <div class="container guide-path-grid">
      <a class="guide-path-card accent-teal" href="/2026/08/sir-bani-yas-island-getting-there-guide">
        <span>01</span>
        <h2>아부다비에서 섬까지</h2>
        <p>E11·Jebel Dhanna Jetty·보트 연결을 하나의 이동으로 계산합니다.</p>
      </a>
      <a class="guide-path-card accent-clay" href="/2026/08/jebel-dhanna-sir-bani-yas-boat-guide">
        <span>02</span>
        <h2>Jebel Dhanna 보트</h2>
        <p>숙박객 water taxi와 day visit 예약 조건을 출발 전에 확인합니다.</p>
      </a>
      <a class="guide-path-card accent-date" href="/2026/08/sir-bani-yas-wildlife-safari-guide">
        <span>03</span>
        <h2>Arabian Wildlife Park</h2>
        <p>17,000마리 이상의 free-roaming animals와 guided wildlife drive를 봅니다.</p>
      </a>
      <a class="guide-path-card" href="/2026/08/sir-bani-yas-island-overnight-itinerary">
        <span>04</span>
        <h2>Sir Bani Yas 1박</h2>
        <p>장거리 이동과 사파리를 하루에 몰지 않고 이틀로 나눕니다.</p>
      </a>
      <a class="guide-path-card" href="/2026/08/al-dhafra-coast-sir-bani-yas-guide">
        <span>05</span>
        <h2>Al Dhafra 해안권</h2>
        <p>Liwa 사막권과 Jebel Dhanna·Sir Bani Yas 해안권을 구분합니다.</p>
      </a>
    </div>
  </section>

  <section class="section section-muted">
    <div class="container source-band">
      <div>
        <p class="eyebrow">FIRST-HAND ARCHIVE</p>
        <h2>2021년 직접 촬영 기록은 현재 안내와 분리해서 연결합니다</h2>
      </div>
      <p>2021년 6월 Sir Bani Yas Island에서 직접 촬영한 해안도로 사진과 56초 영상이 있습니다. 현재 제티·보트·사파리 운영을 증명하는 자료가 아니라 당시 섬의 실제 이동 풍경을 보여 주는 현장 기록입니다.</p>
      <div class="source-links">
        <a href="/2021/06/sir-bani-yas-coastal-road-2021">2021년 해안도로 사진·영상</a>
        <a href="/liwa-guide">Liwa·Al Dhafra 사막 여행</a>
        <a href="/driving-guide">렌터카·장거리 운전</a>
        <a href="/travel-apps-guide">오프라인 지도·앱</a>
      </div>
    </div>
  </section>

  <section class="section" id="sir-bani-yas-guides">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">SIR BANI YAS CLUSTER</p>
          <h2>이동·보트·사파리·숙박을 단계별로 보기</h2>
        </div>
        <p>Experience Abu Dhabi, Abu Dhabi Culture와 운영사 최신 공개 정보를 우선하고, 보트 시간·day pass·액티비티 availability처럼 변동 가능한 항목은 방문 직전에 다시 확인하도록 구성했습니다.</p>
      </div>
      <div class="post-grid">
        {sirBaniYasPosts.map((post) => <PostCard post={post} />)}
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(itemListJson)} />
  <script type="application/ld+json" set:html={JSON.stringify(collectionJson)} />
</BaseLayout>
