---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { site } from "../data/site";
import { coreStoryPermalinks } from "../data/coreStories";
import { formatDate, getPublicPath } from "../utils/posts";
import { getPosts } from "../utils/posts";
import { getHeroImageAlt, getPublicImageSize } from "../utils/images";

const posts = await getPosts();
const heroPost = posts.find((post) => post.data.heroImage) ?? posts[0];
const heroImageSize = heroPost?.data.heroImage ? getPublicImageSize(heroPost.data.heroImage) : undefined;
const heroImageAlt = heroPost?.data.heroImage
  ? getHeroImageAlt(heroPost.body ?? "", heroPost.data.heroImage, heroPost.data.title)
  : "";
const latestPosts = posts.slice(0, 6);
const fieldNotes = posts.filter((post) => post.data.contentType === "field-note");
const featuredFieldNotes = fieldNotes.filter((post) => post.data.heroImage).slice(0, 3);
const corePosts = coreStoryPermalinks
  .map((permalink) => posts.find((post) => post.data.permalink === permalink))
  .filter((post): post is NonNullable<typeof post> => Boolean(post));
const categories = [
  {
    label: "아부다비 한인 생활",
    href: "/life",
    description: "아부다비 날씨·이동·생활 적응과 한인 생활 기록",
    accent: "teal"
  },
  {
    label: "UAE 문화",
    href: "/culture",
    description: "라마단·마즐리스·오드 등 UAE 문화와 예절의 맥락",
    accent: "date"
  },
  {
    label: "과거·현재·미래",
    href: "/past-present-future",
    description: "UAE 도시 변화와 과거·현재·미래를 함께 보는 기록",
    accent: "gold"
  },
  {
    label: "나의 UAE 추억",
    href: "/memory",
    description: "직접 경험하고 촬영한 장소와 오래 남은 개인의 기억",
    accent: "clay"
  }
].map((item) => ({
  ...item,
  count: posts.filter((post) => post.data.category === item.label).length
}));

const startHere = [
  {
    href: "/trip-checklist",
    label: "UAE 여행 준비",
    description: "입국·날씨·이동·문화 공간 방문 전에 확인할 항목을 체크합니다."
  },
  {
    href: "/connectivity-guide",
    label: "유심·eSIM·인터넷",
    description: "공항 무료 Wi-Fi, 무료 관광객 eSIM, e&·du와 로밍을 도착 순서대로 확인합니다."
  },
  {
    href: "/travel-apps-guide",
    label: "여행 앱·디지털 도구",
    description: "Darbi·택시 앱·오프라인 지도·공항·번역·긴급연락 도구를 출국 전에 준비합니다."
  },
  {
    href: "/driving-guide",
    label: "렌터카·운전·주차",
    description: "면허·공항 렌터카, Darb 통행료, MAWAQiF 주차와 ADNOC 주유를 확인합니다."
  },
  {
    href: "/where-to-stay",
    label: "아부다비 숙소 지역 고르기",
    description: "Corniche·도심, Yas, Saadiyat, 공항권을 이동 동선과 여행 목적별로 비교합니다."
  },
  {
    href: "/travel-costs",
    label: "교통비·여행예산 계산",
    description: "공항·Yas·Saadiyat 이동비와 3일·5일 예산을 공식 요금 기준으로 계산합니다."
  },
  {
    href: "/money-guide",
    label: "환전·결제 준비",
    description: "AED 환전, 현금·카드, ATM, 팁과 서비스비를 여행 전에 확인합니다."
  },
  {
    href: "/food-guide",
    label: "음식·식비 계획",
    description: "하루 식비, Emirati 음식, 쇼핑몰 식사와 가족여행 끼니를 따로 봅니다."
  },
  {
    href: "/shopping-guide",
    label: "쇼핑·VAT 환급",
    description: "관광객 VAT 환급, 공항 절차, 쇼핑몰·기념품과 쇼핑 예산을 확인합니다."
  },
  {
    href: "/2026/08/abu-dhabi-3-day-itinerary",
    label: "아부다비 일정 짜기",
    description: "3일·5일 일정과 Yas·Saadiyat·가족여행 동선을 여행 기간에 맞춰 고릅니다."
  },
  {
    href: "/attractions",
    label: "아부다비 관광지 고르기",
    description: "도심·Saadiyat·Yas 관광지를 관심사와 동행자에 맞춰 비교합니다."
  },
  {
    href: "/life",
    label: "아부다비 생활",
    description: "날씨, 이동, 생활 적응과 한인 생활 관련 글을 먼저 봅니다."
  },
  {
    href: "/culture",
    label: "UAE 문화 이해",
    description: "라마단, 마즐리스, 오드와 현지 예절의 맥락을 읽습니다."
  },
  {
    href: "/field-notes",
    label: "직접 촬영 현장 기록",
    description: "작성자가 직접 경험하고 촬영한 사진·영상 기록을 연도별로 봅니다."
  }
];

const homeUrl = new URL("/", site.url).toString();
const heroImageUrl = heroPost?.data.heroImage
  ? new URL(heroPost.data.heroImage, site.url).toString()
  : undefined;
const homePageJson = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${homeUrl}#webpage`,
  url: homeUrl,
  name: site.title,
  description: site.description,
  inLanguage: site.locale,
  isPartOf: { "@id": `${site.url}#website` },
  primaryImageOfPage: heroImageUrl
    ? { "@type": "ImageObject", url: heroImageUrl }
    : undefined,
  about: [
    { "@type": "Thing", name: "UAE 여행" },
    { "@type": "Thing", name: "아부다비 생활" },
    { "@type": "Thing", name: "UAE 문화" },
    { "@type": "Thing", name: "UAE eSIM" },
    { "@type": "Thing", name: "아부다비 여행 앱" },
    { "@type": "Thing", name: "아부다비 렌터카" },
    { "@type": "Thing", name: "아부다비 숙소" },
    { "@type": "Thing", name: "아부다비 교통비" },
    { "@type": "Thing", name: "아부다비 여행 예산" },
    { "@type": "Thing", name: "AED 환전" },
    { "@type": "Thing", name: "아부다비 식비" },
    { "@type": "Thing", name: "아부다비 쇼핑" },
    { "@type": "Thing", name: "UAE VAT refund" },
    { "@type": "Thing", name: "아부다비 관광지" },
    { "@type": "Thing", name: "UAE 현장 기록" }
  ]
};
const hubListJson = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "UAE 여행·생활 핵심 진입점",
  numberOfItems: startHere.length,
  itemListElement: startHere.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.label,
    url: new URL(item.href, site.url).toString()
  }))
};
---

<BaseLayout title={site.title} description={site.description} image={heroPost?.data.heroImage}>
  <section class="home-hero">
    <div class="container home-hero-grid">
      <div class="home-hero-copy">
        <p class="eyebrow">UAE LIFE ARCHIVE</p>
        <h1>UAE 여행·생활·문화, 아부다비에서 직접 기록합니다</h1>
        <p class="lead">
          아부다비에서 살아보니 보이는 UAE를 여행 준비, 생활 적응, 문화의 맥락,
          직접 촬영한 현장 기록으로 나눠 정리합니다.
        </p>
        <div class="hero-actions" aria-label="주요 이동">
          <a class="primary-link" href="/reading-guide">처음부터 읽기</a>
          <a class="secondary-link" href="/connectivity-guide">유심·eSIM</a>
          <a class="secondary-link" href="/travel-apps-guide">여행 앱</a>
          <a class="secondary-link" href="/driving-guide">렌터카·운전</a>
          <a class="secondary-link" href="/where-to-stay">숙소 지역 고르기</a>
          <a class="secondary-link" href="/travel-costs">여행비용 계산</a>
          <a class="secondary-link" href="/shopping-guide">쇼핑·VAT 환급</a>
          <a class="secondary-link" href="/2026/08/abu-dhabi-3-day-itinerary">3일 일정 보기</a>
          <a class="secondary-link" href="/attractions">관광지 고르기</a>
        </div>
      </div>

      {heroPost && (
        <a class="hero-feature" href={getPublicPath(heroPost.data.permalink)} aria-label={`${heroPost.data.title} 읽기`}>
          {heroPost.data.heroImage && (
            <img
              src={heroPost.data.heroImage}
              alt={heroImageAlt}
              width={heroImageSize?.width}
              height={heroImageSize?.height}
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          )}
          <span class="hero-feature-label">FEATURED STORY</span>
          <strong>{heroPost.data.title}</strong>
          <span>{formatDate(heroPost.data.pubDate)} · {heroPost.data.category}</span>
        </a>
      )}
    </div>
  </section>

  <section class="section trust-band">
    <div class="container trust-grid" aria-label="사이트 운영 기준">
      <div>
        <strong>{posts.length}</strong>
        <span>개의 UAE 기록</span>
      </div>
      <div>
        <strong>{fieldNotes.length}</strong>
        <span>개의 직접 경험 현장 기록</span>
      </div>
      <div>
        <strong>경험 + 확인</strong>
        <span>개인 기록과 공개 자료를 구분해 작성</span>
      </div>
    </div>
  </section>

  <section class="section guide-path-section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">START HERE</p>
          <h2>UAE 여행과 생활, 목적별로 바로 보기</h2>
        </div>
        <p>처음 방문하는 여행자와 현지 생활 기록을 찾는 독자가 가장 필요한 페이지부터 바로 이동할 수 있습니다.</p>
      </div>
      <div class="guide-path-grid">
        {startHere.map((item, index) => (
          <a class="guide-path-card" href={item.href}>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <div>
              <h2>{item.label}</h2>
              <p>{item.description}</p>
            </div>
          </a>
        ))}
      </div>
      <div class="hero-actions" aria-label="핵심 아카이브 바로가기">
        <a class="secondary-link" href="/2026/08/uae-personal-photo-archive">2012~2022 개인 사진 아카이브</a>
        <a class="secondary-link" href="/reading-guide">UAE 읽기 길잡이</a>
      </div>
    </div>
  </section>

  {corePosts.length > 0 && (
    <section class="section section-muted" aria-labelledby="core-stories-title">
      <div class="container">
        <div class="section-head">
          <div>
            <p class="eyebrow">CORE STORIES</p>
            <h2 id="core-stories-title">먼저 읽을 UAE 핵심 글</h2>
          </div>
          <p>여행 준비와 생활 적응에 필요한 가이드부터, 이 사이트에서만 볼 수 있는 직접 촬영 기록까지 우선순위대로 묶었습니다.</p>
        </div>
        <div class="post-grid">
          {corePosts.slice(0, 6).map((post) => <PostCard post={post} />)}
        </div>
        <div class="hero-actions">
          <a class="primary-link" href="/reading-guide">핵심 글 전체 보기</a>
          <a class="secondary-link" href="/field-notes">직접 촬영 기록만 보기</a>
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">EXPLORE</p>
          <h2>주제별 UAE 기록</h2>
        </div>
        <p>한인 생활 적응, UAE 문화, 시간의 흐름, 개인의 기억을 분리해 필요한 글로 바로 이동할 수 있습니다.</p>
      </div>
      <div class="category-grid">
        {categories.map((category) => (
          <a class:list={["category-card", `accent-${category.accent}`]} href={category.href}>
            <span>{category.count} stories</span>
            <h3>{category.label}</h3>
            <p>{category.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  {featuredFieldNotes.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head">
          <div>
            <p class="eyebrow">FIRST-HAND RECORDS</p>
            <h2>직접 촬영한 UAE 현장 기록</h2>
          </div>
          <p>
            직접 경험하고 촬영한 장소와 생활 장면입니다. 게시일과 촬영 시점이 다를 수 있어 각 글의 ‘기록 범위’를 함께 표시합니다.
          </p>
        </div>
        <div class="post-grid">
          {featuredFieldNotes.map((post) => <PostCard post={post} />)}
        </div>
        <div class="hero-actions" aria-label="현장 기록 더 보기">
          <a class="primary-link" href="/field-notes">전체 현장 기록 보기</a>
          <a class="secondary-link" href="/2026/08/uae-personal-photo-archive">2012~2022 개인 사진 색인</a>
        </div>
      </div>
    </section>
  )}

  <section class="section section-muted" id="latest">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">LATEST STORIES</p>
          <h2>최근 기록</h2>
        </div>
        <p>새 글과 옮겨온 글을 같은 형식으로 정리해, 독자가 자연스럽게 다음 글로 이어갈 수 있게 했습니다.</p>
      </div>
      <div class="post-grid">
        {latestPosts.map((post) => <PostCard post={post} />)}
      </div>
    </div>
  </section>

  <section class="section note-section">
    <div class="container note-panel">
      <p class="eyebrow">EDITORIAL NOTE</p>
      <h2>기록의 기준</h2>
      <p>
        개인 경험은 경험으로, 바뀔 수 있는 정보는 확인이 필요한 정보로 씁니다.
        UAE의 장소와 문화가 낯선 독자에게는 맥락을, 이미 살아본 사람에게는 추억을 남기는 사이트를 목표로 합니다.
      </p>
      <a class="secondary-link" href="/editorial-policy">작성·수정 원칙 보기</a>
      <a class="secondary-link" href="/reading-guide">UAE 읽기 길잡이</a>
    </div>
  </section>
  <script type="application/ld+json" set:html={JSON.stringify(homePageJson)} />
  <script type="application/ld+json" set:html={JSON.stringify(hubListJson)} />
</BaseLayout>