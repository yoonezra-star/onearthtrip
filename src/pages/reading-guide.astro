---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { getPosts } from "../utils/posts";

const posts = await getPosts();
const guides = posts.filter((post) => post.data.contentType === "guide").slice(0, 3);
const fieldNotes = posts.filter((post) => post.data.contentType === "field-note").slice(0, 6);
---

<BaseLayout
  title="UAE 읽기 길잡이 | On Earth Trip"
  description="UAE를 처음 준비하는 독자와 현장 기록을 읽고 싶은 독자를 위한 On Earth Trip의 읽기 순서입니다."
>
  <section class="page-hero">
    <div class="container page-hero-inner">
      <p class="eyebrow">START HERE</p>
      <h1>UAE 읽기 길잡이</h1>
      <p class="lead">준비할 때 필요한 정보와, 실제 장소에서 남은 기록을 분리해 읽을 수 있습니다.</p>
    </div>
  </section>

  <section class="section guide-path-section">
    <div class="container guide-path-grid">
      <a class="guide-path-card accent-teal" href="/trip-checklist">
        <span>01</span>
        <h2>출발 전 확인</h2>
        <p>입국·날씨·이동·문화 공간 방문 전 항목을 체크합니다.</p>
      </a>
      <a class="guide-path-card accent-date" href="/culture">
        <span>02</span>
        <h2>문화의 맥락</h2>
        <p>라마단, 마즐리스, 오드처럼 장소를 이해하는 글을 읽습니다.</p>
      </a>
      <a class="guide-path-card accent-clay" href="/field-notes">
        <span>03</span>
        <h2>현장 기록</h2>
        <p>작성자가 직접 경험하고 촬영한 장소와 생활 장면을 연도별로 읽습니다.</p>
      </a>
    </div>
  </section>

  <section class="section section-muted">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">PRACTICAL GUIDES</p>
          <h2>처음 준비할 때 읽을 글</h2>
        </div>
        <p>운영 시간·날씨·이동처럼 바뀔 수 있는 내용은 글 안의 공식 출처와 수정일을 함께 확인합니다.</p>
      </div>
      <div class="post-grid">
        {guides.map((post) => <PostCard post={post} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">FIELD NOTES</p>
          <h2>장소에서 남은 기록</h2>
        </div>
        <p>현장 기록 표시는 작성자의 경험 범위를 뜻하며, 일반적인 규정이나 최신 조건은 별도로 확인해야 합니다.</p>
      </div>
      <div class="post-grid">
        {fieldNotes.map((post) => <PostCard post={post} />)}
      </div>
    </div>
  </section>
</BaseLayout>
