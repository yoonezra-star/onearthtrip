---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { coreStoryPermalinks } from "../data/coreStories";
import { planningStoryPermalinks } from "../data/planningStories";
import { attractionStoryPermalinks } from "../data/attractionStories";
import { downtownStoryPermalinks } from "../data/downtownStories";
import { stayStoryPermalinks } from "../data/stayStories";
import { costStoryPermalinks } from "../data/costStories";
import { foodStoryPermalinks } from "../data/foodStories";
import { moneyStoryPermalinks } from "../data/moneyStories";
import { shoppingStoryPermalinks } from "../data/shoppingStories";
import { connectivityStoryPermalinks } from "../data/connectivityStories";
import { travelAppStoryPermalinks } from "../data/travelAppStories";
import { drivingStoryPermalinks } from "../data/drivingStories";
import { getPosts } from "../utils/posts";

const posts = await getPosts();
const corePosts = coreStoryPermalinks
  .map((permalink) => posts.find((post) => post.data.permalink === permalink))
  .filter((post): post is NonNullable<typeof post> => Boolean(post));
const planningPosts = planningStoryPermalinks
  .map((permalink) => posts.find((post) => post.data.permalink === permalink))
  .filter((post): post is NonNullable<typeof post> => Boolean(post));
const attractionPosts = attractionStoryPermalinks
  .map((permalink) => posts.find((post) => post.data.permalink === permalink))
  .filter((post): post is NonNullable<typeof post> => Boolean(post));
const downtownPosts = downtownStoryPermalinks
  .map((permalink) => posts.find((post) => post.data.permalink === permalink))
  .filter((post): post is NonNullable<typeof post> => Boolean(post));
const stayPosts = stayStoryPermalinks
  .map((permalink) => posts.find((post) => post.data.permalink === permalink))
  .filter((post): post is NonNullable<typeof post> => Boolean(post));
const costPosts = costStoryPermalinks
  .map((permalink) => posts.find((post) => post.data.permalink === permalink))
  .filter((post): post is NonNullable<typeof post> => Boolean(post));
const foodPosts = foodStoryPermalinks
  .map((permalink) => posts.find((post) => post.data.permalink === permalink))
  .filter((post): post is NonNullable<typeof post> => Boolean(post));
const moneyPosts = moneyStoryPermalinks
  .map((permalink) => posts.find((post) => post.data.permalink === permalink))
  .filter((post): post is NonNullable<typeof post> => Boolean(post));
const shoppingPosts = shoppingStoryPermalinks
  .map((permalink) => posts.find((post) => post.data.permalink === permalink))
  .filter((post): post is NonNullable<typeof post> => Boolean(post));
const connectivityPosts = connectivityStoryPermalinks
  .map((permalink) => posts.find((post) => post.data.permalink === permalink))
  .filter((post): post is NonNullable<typeof post> => Boolean(post));
const appPosts = travelAppStoryPermalinks
  .map((permalink) => posts.find((post) => post.data.permalink === permalink))
  .filter((post): post is NonNullable<typeof post> => Boolean(post));
const drivingPosts = drivingStoryPermalinks
  .map((permalink) => posts.find((post) => post.data.permalink === permalink))
  .filter((post): post is NonNullable<typeof post> => Boolean(post));
const attractionCount = attractionPosts.length + downtownPosts.length;
const guides = corePosts.filter((post) => post.data.contentType !== "field-note");
const fieldNotes = corePosts.filter((post) => post.data.contentType === "field-note");
---

<BaseLayout
  title="UAE 여행 준비·현장 기록 읽기 길잡이 | On Earth Trip"
  description="UAE 입국, 유심·eSIM, 여행 앱, 렌터카·운전, 아부다비 숙소·교통비·환전·식비·쇼핑, 일정, 관광지와 직접 촬영 현장 기록까지 목적별로 정리한 시작 페이지입니다."
>
  <section class="page-hero">
    <div class="container page-hero-inner">
      <p class="eyebrow">START HERE</p>
      <h1>UAE 여행·생활 읽기 길잡이</h1>
      <p class="lead">검색으로 처음 들어온 독자도 여행 준비, 인터넷 연결, 앱·지도, 렌터카·운전, 숙소, 비용, 결제, 음식, 쇼핑, 일정, 관광지 선택과 실제 사진·영상 기록을 구분해 필요한 글부터 읽을 수 있습니다.</p>
      <p class="page-summary">{guides.length}개 핵심 가이드 · {connectivityPosts.length}개 유심·eSIM 가이드 · {appPosts.length}개 여행 앱 가이드 · {drivingPosts.length}개 렌터카·운전 가이드 · {stayPosts.length}개 숙소 지역 가이드 · {costPosts.length}개 비용 가이드 · {moneyPosts.length}개 환전·결제 가이드 · {foodPosts.length}개 음식·식비 가이드 · {shoppingPosts.length}개 쇼핑 가이드 · {planningPosts.length}개 여행 일정 · {attractionCount}개 관광지 가이드 · {fieldNotes.length}개 대표 현장 기록</p>
    </div>
  </section>

  <section class="section guide-path-section">
    <div class="container guide-path-grid">
      <a class="guide-path-card accent-teal" href="/2026/08/uae-entry-checklist-before-travel">
        <span>01</span>
        <h2>UAE 입국·여행 준비</h2>
        <p>비자·여권·반입 제한부터 공항 도착 이후 첫 이동까지 순서대로 확인합니다.</p>
      </a>
      <a class="guide-path-card accent-teal" href="/connectivity-guide">
        <span>02</span>
        <h2>유심·eSIM·인터넷 연결</h2>
        <p>공항 무료 Wi-Fi, 무료 관광객 eSIM, e&amp;·du와 로밍을 도착 순서대로 확인합니다.</p>
      </a>
      <a class="guide-path-card accent-teal" href="/travel-apps-guide">
        <span>03</span>
        <h2>여행 앱·디지털 도구</h2>
        <p>Darbi·택시 호출·오프라인 지도·공항·번역·긴급연락 도구를 출국 전에 준비합니다.</p>
      </a>
      <a class="guide-path-card accent-teal" href="/driving-guide">
        <span>04</span>
        <h2>렌터카·운전·주차</h2>
        <p>면허·보험, 공항 렌터카, Darb 통행료, MAWAQiF 주차와 ADNOC 주유를 확인합니다.</p>
      </a>
      <a class="guide-path-card accent-teal" href="/where-to-stay">
        <span>05</span>
        <h2>아부다비 숙소 지역 고르기</h2>
        <p>Corniche·도심, Yas, Saadiyat, 공항권을 여행 목적과 이동시간으로 비교합니다.</p>
      </a>
      <a class="guide-path-card accent-teal" href="/travel-costs">
        <span>06</span>
        <h2>교통비·여행예산 계산</h2>
        <p>공항·Yas·Saadiyat 이동비와 3일·5일 현지예산을 공식 요금 기준으로 계산합니다.</p>
      </a>
      <a class="guide-path-card accent-teal" href="/money-guide">
        <span>07</span>
        <h2>환전·결제 준비</h2>
        <p>AED 환전, 카드, ATM, 팁과 서비스비를 실제 돈 사용 순서대로 확인합니다.</p>
      </a>
      <a class="guide-path-card accent-date" href="/food-guide">
        <span>08</span>
        <h2>음식·식비 계획</h2>
        <p>하루 식비, Emirati 음식, 쇼핑몰 식사와 가족여행 끼니를 따로 계획합니다.</p>
      </a>
      <a class="guide-path-card accent-date" href="/shopping-guide">
        <span>09</span>
        <h2>쇼핑·VAT 환급</h2>
        <p>관광객 VAT 환급, 공항 절차, 쇼핑몰·기념품과 쇼핑 예산을 함께 봅니다.</p>
      </a>
      <a class="guide-path-card accent-teal" href="/2026/08/abu-dhabi-3-day-itinerary">
        <span>10</span>
        <h2>아부다비 일정 짜기</h2>
        <p>3일·5일 일정과 도심·Saadiyat·Yas·가족여행을 여행 기간과 목적에 맞춰 고릅니다.</p>
      </a>
      <a class="guide-path-card accent-date" href="/attractions">
        <span>11</span>
        <h2>아부다비 관광지 고르기</h2>
        <p>Downtown의 역사·궁전·해안, Saadiyat 박물관, Yas Island 테마파크를 지역별로 비교합니다.</p>
      </a>
      <a class="guide-path-card accent-date" href="/culture">
        <span>12</span>
        <h2>UAE 문화 이해</h2>
        <p>라마단, 공휴일, 모스크 방문과 현지 문화 공간의 맥락을 읽습니다.</p>
      </a>
      <a class="guide-path-card accent-clay" href="/field-notes">
        <span>13</span>
        <h2>직접 촬영 현장 기록</h2>
        <p>작성자가 직접 경험하고 촬영한 장소와 생활 장면을 실제 기록 시점 기준으로 읽습니다.</p>
      </a>
      <a class="guide-path-card" href="/2026/08/uae-personal-photo-archive">
        <span>14</span>
        <h2>2012~2022 개인 사진 아카이브</h2>
        <p>아부다비와 두바이 등에서 직접 촬영한 사진·영상 기록을 연도별 색인으로 봅니다.</p>
      </a>
    </div>
  </section>

  <section class="section section-muted">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">CONNECTIVITY CLUSTER</p>
          <h2>공항 Wi-Fi와 관광객 eSIM부터 연결하기</h2>
        </div>
        <p>자이드 국제공항 유심·eSIM, 무료 10GB·24시간 옵션, e&amp;·du 비교, 데이터 용량과 로밍 백업을 한 흐름으로 정리했습니다.</p>
      </div>
      <div class="post-grid">
        {connectivityPosts.map((post) => <PostCard post={post} />)}
      </div>
      <div class="hero-actions">
        <a class="primary-link" href="/connectivity-guide">유심·eSIM 허브 보기</a>
        <a class="secondary-link" href="/2026/08/zayed-airport-tourist-sim-esim-guide">공항에서 바로 연결</a>
        <a class="secondary-link" href="/2026/08/etisalat-du-tourist-sim-comparison">e&amp; vs du 비교</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">TRAVEL APPS &amp; DIGITAL TOOLS</p>
          <h2>인터넷 연결 다음에는 앱과 오프라인 백업을 준비하기</h2>
        </div>
        <p>Darbi·Abu Dhabi Taxi·Careem·Uber, 오프라인 지도, AUH Guest·Etihad, 오프라인 번역과 UAE 긴급연락을 다섯 가지 검색 의도로 나눴습니다.</p>
      </div>
      <div class="post-grid">
        {appPosts.map((post) => <PostCard post={post} />)}
      </div>
      <div class="hero-actions">
        <a class="primary-link" href="/travel-apps-guide">여행 앱 허브 보기</a>
        <a class="secondary-link" href="/2026/08/abu-dhabi-transport-apps-guide">교통 앱 정리</a>
        <a class="secondary-link" href="/2026/08/abu-dhabi-offline-map-navigation-guide">오프라인 지도</a>
      </div>
    </div>
  </section>

  <section class="section section-muted">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">DRIVING &amp; CAR RENTAL CLUSTER</p>
          <h2>렌터카는 면허·통행료·주차·주유까지 한 번에 보기</h2>
        </div>
        <p>국제운전면허·공항 렌터카, Darb 통행료, MAWAQiF 주차와 ADNOC 주유를 실제 운전 순서대로 나눴습니다.</p>
      </div>
      <div class="post-grid">
        {drivingPosts.map((post) => <PostCard post={post} />)}
      </div>
      <div class="hero-actions">
        <a class="primary-link" href="/driving-guide">렌터카·운전 허브 보기</a>
        <a class="secondary-link" href="/2026/08/abu-dhabi-driving-rental-car-guide">면허·보험 준비</a>
        <a class="secondary-link" href="/2026/08/abu-dhabi-darb-toll-guide">Darb 통행료</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">STAY CLUSTER</p>
          <h2>숙소는 호텔보다 지역부터 고르기</h2>
        </div>
        <p>Corniche·도심, Yas Island, Saadiyat Island, Al Raha·공항권을 관광 목적과 이동시간으로 비교합니다.</p>
      </div>
      <div class="post-grid">
        {stayPosts.map((post) => <PostCard post={post} />)}
      </div>
      <div class="hero-actions">
        <a class="primary-link" href="/where-to-stay">숙소 지역 허브 보기</a>
        <a class="secondary-link" href="/2026/08/abu-dhabi-where-to-stay-area-guide">전체 지역 비교</a>
      </div>
    </div>
  </section>

  <section class="section section-muted">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">TRAVEL COST CLUSTER</p>
          <h2>숙소와 일정을 정하기 전 이동비부터 계산하기</h2>
        </div>
        <p>공항→도심, 도심↔Yas·Saadiyat 교통비와 3일·5일 예산을 현재 공식 버스·택시 요금으로 계산합니다.</p>
      </div>
      <div class="post-grid">
        {costPosts.map((post) => <PostCard post={post} />)}
      </div>
      <div class="hero-actions">
        <a class="primary-link" href="/travel-costs">교통비·여행예산 허브 보기</a>
        <a class="secondary-link" href="/2026/08/abu-dhabi-3-day-travel-budget">3일 예산 계산</a>
        <a class="secondary-link" href="/2026/08/abu-dhabi-5-day-travel-budget">5일 예산 계산</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">MONEY &amp; PAYMENT CLUSTER</p>
          <h2>AED 환전과 결제수단을 미리 나누기</h2>
        </div>
        <p>현금·카드 비중, AED 환전, 공항 환전·ATM, 해외카드 출금, 팁·서비스비를 실제 여행 순서대로 정리했습니다.</p>
      </div>
      <div class="post-grid">
        {moneyPosts.map((post) => <PostCard post={post} />)}
      </div>
      <div class="hero-actions">
        <a class="primary-link" href="/money-guide">환전·결제 허브 보기</a>
        <a class="secondary-link" href="/2026/08/aed-exchange-guide">AED 환전 확인</a>
        <a class="secondary-link" href="/2026/08/abu-dhabi-cash-card-payment-guide">현금·카드 비중</a>
      </div>
    </div>
  </section>

  <section class="section section-muted">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">FOOD &amp; DINING CLUSTER</p>
          <h2>하루 식비와 현지 음식을 따로 계획하기</h2>
        </div>
        <p>하루 식비 계산, Emirati 음식 입문, 절약형 식사, 쇼핑몰 다이닝, 가족여행 끼니를 서로 겹치지 않게 나눴습니다.</p>
      </div>
      <div class="post-grid">
        {foodPosts.map((post) => <PostCard post={post} />)}
      </div>
      <div class="hero-actions">
        <a class="primary-link" href="/food-guide">음식·식비 허브 보기</a>
        <a class="secondary-link" href="/2026/08/abu-dhabi-daily-food-budget">하루 식비 계산</a>
        <a class="secondary-link" href="/2026/08/emirati-food-first-timer-guide">UAE 현지 음식 입문</a>
      </div>
    </div>
  </section>

  <section class="section section-muted">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">SHOPPING &amp; VAT CLUSTER</p>
          <h2>쇼핑은 VAT 환급 가능 여부와 출국 절차까지 함께 보기</h2>
        </div>
        <p>관광객 VAT 환급, 자이드 국제공항 검증, 쇼핑몰 선택, 기념품과 쇼핑 예산을 한 클러스터로 연결했습니다.</p>
      </div>
      <div class="post-grid">
        {shoppingPosts.map((post) => <PostCard post={post} />)}
      </div>
      <div class="hero-actions">
        <a class="primary-link" href="/shopping-guide">쇼핑·VAT 환급 허브 보기</a>
        <a class="secondary-link" href="/2026/08/uae-tourist-vat-refund-guide">VAT 환급 조건</a>
        <a class="secondary-link" href="/2026/08/abu-dhabi-shopping-mall-comparison">쇼핑몰 비교</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">TRAVEL PLANNING CLUSTER</p>
          <h2>아부다비 일정부터 고르기</h2>
        </div>
        <p>3일·5일 전체 일정과 Yas Island, Saadiyat, 가족·여름 실내여행을 서로 겹치지 않게 나눈 여행 계획 클러스터입니다.</p>
      </div>
      <div class="post-grid">
        {planningPosts.map((post) => <PostCard post={post} />)}
      </div>
    </div>
  </section>

  <section class="section section-muted" id="downtown-attractions">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">DOWNTOWN ATTRACTION CLUSTER</p>
          <h2>도심 관광지는 역사·궁전·해안으로 나눠 보기</h2>
        </div>
        <p>Qasr Al Hosn, Qasr Al Watan, Emirates Palace, Corniche, Heritage Village를 같은 도심권 안에서 묶어 이동 부담을 줄입니다.</p>
      </div>
      <div class="post-grid">
        {downtownPosts.map((post) => <PostCard post={post} />)}
      </div>
      <div class="hero-actions">
        <a class="primary-link" href="/downtown-attractions">도심 관광지 허브 보기</a>
        <a class="secondary-link" href="/2026/08/abu-dhabi-3-day-itinerary">3일 일정에 넣기</a>
      </div>
    </div>
  </section>

  <section class="section" id="attractions">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">SAADIYAT &amp; YAS ATTRACTION CLUSTER</p>
          <h2>박물관과 테마파크는 운영시간·입장 조건부터 확인하기</h2>
        </div>
