---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { getPosts } from "../utils/posts";
import { site } from "../data/site";

const posts = await getPosts();
const guides = posts.filter((post) => post.data.contentType !== "field-note");
const fieldNotes = posts.filter((post) => post.data.contentType === "field-note");

const representativePermalinks = [
  "/2026/08/uae-entry-checklist-before-travel.html",
  "/2026/08/abu-dhabi-3-day-itinerary.html",
  "/2026/08/sheikh-zayed-grand-mosque-visit-guide.html",
  "/2026/08/abu-dhabi-public-transport-guide.html",
  "/2026/04/blog-post_11.html",
  "/2021/06/sir-bani-yas-coastal-road-2021.html"
];
const representativePosts = representativePermalinks
  .map((permalink) => posts.find((post) => post.data.permalink === permalink))
  .filter((post): post is NonNullable<typeof post> => Boolean(post));

const topPaths = [
  {
    href: "/trip-checklist",
    label: "여행 준비",
    description: "입국 전 확인부터 공항 도착, 통신·앱·교통 준비까지 출발 순서대로 봅니다."
  },
  {
    href: "/2026/08/abu-dhabi-3-day-itinerary",
    label: "일정·관광",
    description: "3일 일정에서 시작해 숙소 지역과 Downtown·Saadiyat·Yas 관광지로 확장합니다."
  },
  {
    href: "/intercity-guide",
    label: "근교·지역 이동",
    description: "두바이·알아인·Liwa·Sir Bani Yas·Al Wathba처럼 도심 밖으로 나가는 여행을 고릅니다."
  },
  {
    href: "/life",
    label: "생활·문화",
    description: "아부다비 생활 정보와 UAE 문화·예절을 실제 생활 맥락과 함께 읽습니다."
  },
  {
    href: "/field-notes",
    label: "직접 경험 기록",
    description: "작성자가 직접 방문하거나 촬영한 사진·영상 기록을 실제 기록 시점 기준으로 봅니다."
  }
];

const detailGroups = [
  {
    title: "출발 전·도착 직후",
    description: "공항에 도착한 뒤 바로 필요한 연결과 이동 도구입니다.",
    links: [
      { href: "/connectivity-guide", label: "유심·eSIM·인터넷" },
      { href: "/travel-apps-guide", label: "여행 앱·오프라인 지도" },
      { href: "/driving-guide", label: "렌터카·운전·주차" },
      { href: "/2026/08/zayed-international-airport-to-abu-dhabi-city", label: "공항에서 아부다비 도심 이동" }
    ]
  },
  {
    title: "숙소·돈·식사",
    description: "여행 기간과 예산을 정한 뒤 실제 체류 비용을 세분화합니다.",
    links: [
      { href: "/where-to-stay", label: "숙소 지역 비교" },
      { href: "/travel-costs", label: "교통비·여행예산" },
      { href: "/money-guide", label: "환전·카드·ATM" },
      { href: "/food-guide", label: "음식·식비" },
      { href: "/shopping-guide", label: "쇼핑·VAT 환급" }
    ]
  },
  {
    title: "아부다비 관광",
    description: "관광지를 많이 나열하기보다 지역과 동행자에 맞춰 선택합니다.",
    links: [
      { href: "/attractions", label: "아부다비 관광지 전체" },
      { href: "/downtown-attractions", label: "Downtown 관광지" },
      { href: "/2026/08/saadiyat-downtown-planning-guide", label: "Saadiyat·도심 계획" },
      { href: "/2026/08/yas-island-planning-guide", label: "Yas Island 하루 계획" }
    ]
  },
  {
    title: "도심 밖 지역 여행",
    description: "이동시간이 길어지는 지역은 별도 허브에서 교통과 하루 일정을 함께 확인합니다.",
    links: [
      { href: "/intercity-guide", label: "아부다비↔두바이" },
      { href: "/al-ain-guide", label: "Al Ain" },
      { href: "/liwa-guide", label: "Liwa·Al Dhafra" },
      { href: "/sir-bani-yas-guide", label: "Sir Bani Yas" },
      { href: "/al-wathba-guide", label: "Al Wathba" }
    ]
  },
  {
    title: "문화와 직접 기록",
    description: "현재 확인형 가이드와 개인 경험 아카이브를 서로 다른 성격으로 구분해 읽습니다.",
    links: [
      { href: "/culture", label: "UAE 문화" },
      { href: "/field-notes", label: "현장 기록 아카이브" },
      { href: "/2026/08/uae-personal-photo-archive", label: "2012~2022 개인 사진 아카이브" },
      { href: "/author", label: "운영자와 경험 범위" },
      { href: "/editorial-policy", label: "작성·수정 원칙" }
    ]
  }
];

const pageUrl = new URL("/reading-guide", site.url).toString();
const pathListId = `${pageUrl}#reading-paths`;
const pageJson = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${pageUrl}#webpage`,
  url: pageUrl,
  name: "UAE 여행·생활 읽기 길잡이",
  description: "UAE 여행 준비, 아부다비 일정과 관광, 지역 이동, 생활·문화, 직접 경험 기록을 다섯 경로로 정리한 시작 페이지입니다.",
  inLanguage: site.locale,
  isPartOf: { "@id": `${site.url}#website` },
  mainEntity: { "@id": pathListId }
};
const pathListJson = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "@id": pathListId,
  name: "On Earth Trip 핵심 읽기 경로",
  numberOfItems: topPaths.length,
  itemListElement: topPaths.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.label,
    url: new URL(item.href, site.url).toString()
  }))
};
---

<BaseLayout
  title="UAE 여행·생활 읽기 길잡이 | On Earth Trip"
  description="UAE 여행 준비, 아부다비 일정·관광, 근교 이동, 생활·문화와 직접 촬영 현장 기록을 다섯 개 핵심 경로로 정리한 시작 페이지입니다."
>
  <section class="page-hero">
    <div class="container page-hero-inner">
      <p class="eyebrow">START HERE</p>
      <h1>UAE 여행·생활, 다섯 경로에서 시작합니다</h1>
      <p class="lead">
        글이 많아도 처음부터 모두 볼 필요는 없습니다. 여행 준비, 일정·관광, 지역 이동,
        생활·문화, 직접 경험 기록 중 지금 필요한 경로 하나를 먼저 고르세요.
      </p>
      <p class="page-summary">
        현재 {posts.length}개 글 · {guides.length}개 실용 가이드 · {fieldNotes.length}개 직접 경험 현장 기록
      </p>
      <div class="hero-actions">
        <a class="primary-link" href="/search">사이트에서 직접 검색</a>
        <a class="secondary-link" href="/author">누가 쓰는지 보기</a>
        <a class="secondary-link" href="/editorial-policy">작성 기준 보기</a>
      </div>
    </div>
  </section>

  <section class="section guide-path-section" aria-labelledby="main-paths-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">5 READING PATHS</p>
          <h2 id="main-paths-title">먼저 필요한 한 가지를 고릅니다</h2>
        </div>
        <p>세부 주제는 각 허브 안에서 다시 나뉩니다. 첫 화면에서는 큰 목적만 보여 줍니다.</p>
      </div>
      <div class="guide-path-grid">
        {topPaths.map((item, index) => (
          <a class="guide-path-card" href={item.href}>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <div>
              <h2>{item.label}</h2>
              <p>{item.description}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  {representativePosts.length > 0 && (
    <section class="section section-muted" aria-labelledby="representative-title">
      <div class="container">
        <div class="section-head">
          <div>
            <p class="eyebrow">EDITOR'S START</p>
            <h2 id="representative-title">대표 글 6개</h2>
          </div>
          <p>공식 확인형 가이드와 직접 촬영 기록을 함께 보여 주되, 두 콘텐츠의 성격은 각 글에서 명확히 구분합니다.</p>
        </div>
        <div class="post-grid">
          {representativePosts.map((post) => <PostCard post={post} />)}
        </div>
      </div>
    </section>
  )}

  <section class="section" aria-labelledby="detail-hubs-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">DETAILED HUBS</p>
          <h2 id="detail-hubs-title">더 구체적인 주제가 필요할 때</h2>
        </div>
        <p>세부 가이드를 전부 펼치지 않고, 같은 목적의 글을 모은 허브로 연결합니다.</p>
      </div>
      <div class="reading-hub-grid">
        {detailGroups.map((group) => (
          <article class="reading-hub-card">
            <h2>{group.title}</h2>
            <p>{group.description}</p>
            <div class="reading-link-list">
              {group.links.map((link) => (
                <a href={link.href}>{link.label}<span aria-hidden="true">→</span></a>
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-muted" aria-labelledby="evidence-title">
    <div class="container source-band">
      <div>
        <p class="eyebrow">HOW THIS SITE IS BUILT</p>
        <h2 id="evidence-title">현재 정보와 직접 경험을 섞지 않습니다</h2>
      </div>
      <p>
        교통·가격·운영시간처럼 바뀌는 내용은 공식 출처를 우선해 확인합니다. 직접 촬영 사진과 개인 경험은
        촬영·방문 시점을 표시하고, 과거 기록을 현재 이용 정보처럼 사용하지 않습니다.
      </p>
      <div class="source-links">
        <a href="/field-notes">직접 경험 기록 보기</a>
        <a href="/2026/08/uae-personal-photo-archive">개인 사진 아카이브</a>
        <a href="/editorial-policy">작성·수정 원칙</a>
      </div>
    </div>
  </section>

  <section class="section note-section">
    <div class="container note-panel">
      <p class="eyebrow">CAN'T FIND IT?</p>
      <h2>세부 주제는 검색으로 찾는 편이 빠릅니다</h2>
      <p>eSIM, VAT, 렌터카, Corniche, Yas Island처럼 구체적인 키워드는 사이트 검색에서 제목·설명·태그를 함께 찾습니다.</p>
      <a class="primary-link" href="/search">사이트 검색 열기</a>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(pageJson)} />
  <script type="application/ld+json" set:html={JSON.stringify(pathListJson)} />
</BaseLayout>

<style>
  .reading-hub-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .reading-hub-card {
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 24px;
    background: var(--surface);
    box-shadow: var(--shadow-soft);
  }

  .reading-hub-card h2 {
    margin: 0 0 8px;
    font-size: 1.15rem;
  }

  .reading-hub-card > p {
    margin: 0 0 16px;
    color: var(--muted);
  }

  .reading-link-list {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--line);
  }

  .reading-link-list a {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 11px 0;
    border-bottom: 1px solid var(--line);
    font-weight: 800;
  }

  @media (max-width: 720px) {
    .reading-hub-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
