---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import PlaceMap from "../components/PlaceMap.astro";
import { getCoreStoryRank, isCoreStory } from "../data/coreStories";
import { getSeoMeta } from "../data/seoMeta.mjs";
import { getPosts } from "../utils/posts";
import { formatDate, getCategoryPath, getPublicPath, getReadingTime } from "../utils/posts";
import { getHeroImageAlt, getPublicImageSize } from "../utils/images";
import { site } from "../data/site";

type Props = {
  post: CollectionEntry<"posts">;
};

const { post } = Astro.props;
const seoMeta = getSeoMeta(post.data.permalink);
const title = `${seoMeta?.title ?? post.data.title} | ${site.name}`;
const metaDescription = seoMeta?.description ?? post.data.description;
const canonical = getPublicPath(post.data.permalink);
const readingTime = getReadingTime(post.body ?? "");
const canonicalUrl = new URL(canonical, site.url).toString();
const heroImageUrl = post.data.heroImage
  ? new URL(post.data.heroImage, site.url).toString()
  : undefined;
const heroImageSize = post.data.heroImage ? getPublicImageSize(post.data.heroImage) : undefined;
const heroImageAlt = post.data.heroImage
  ? getHeroImageAlt(post.body ?? "", post.data.heroImage, post.data.title)
  : "";
const authorUrl = new URL("/author", site.url).toString();
const authorId = `${authorUrl}#person`;
const allPosts = await getPosts();
const getRelatedScore = (item: CollectionEntry<"posts">) => {
  const sharedTags = item.data.tags.filter((tag) => post.data.tags.includes(tag)).length;
  const coreBoost = isCoreStory(item.data.permalink) ? 20 : 0;
  const typeBridge = item.data.contentType !== post.data.contentType ? 1 : 0;
  return coreBoost + sharedTags * 3 + typeBridge;
};
const relatedPosts = allPosts
  .filter((item) => item.id !== post.id && item.data.category === post.data.category)
  .sort((a, b) => {
    const scoreDifference = getRelatedScore(b) - getRelatedScore(a);
    if (scoreDifference !== 0) return scoreDifference;

    const rankDifference = getCoreStoryRank(a.data.permalink) - getCoreStoryRank(b.data.permalink);
    if (rankDifference !== 0) return rankDifference;

    return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
  })
  .slice(0, 3);
const articleJson = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": `${canonicalUrl}#article`,
  url: canonicalUrl,
  headline: post.data.title,
  description: metaDescription,
  image: heroImageUrl,
  thumbnailUrl: heroImageUrl,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  author: {
    "@type": "Person",
    "@id": authorId,
    name: post.data.author,
    url: authorUrl
  },
  publisher: {
    "@type": "Organization",
    "@id": `${site.url}#organization`,
    name: site.name
  },
  isPartOf: {
    "@type": "WebSite",
    "@id": `${site.url}#website`,
    name: site.name,
    url: site.url
  },
  mainEntityOfPage: canonicalUrl,
  inLanguage: site.locale,
  isAccessibleForFree: true,
  articleSection: post.data.category,
  genre: post.data.contentType === "field-note" ? "현장 기록" : "가이드",
  keywords: post.data.tags
};
const breadcrumbJson = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "홈", item: site.url },
    {
      "@type": "ListItem",
      position: 2,
      name: post.data.category,
      item: new URL(getCategoryPath(post.data.category), site.url).toString()
    },
    { "@type": "ListItem", position: 3, name: post.data.title, item: canonicalUrl }
  ]
};
---

<BaseLayout
  title={title}
  description={metaDescription}
  image={post.data.heroImage}
  canonical={canonical}
  pageType="article"
  publishedTime={post.data.pubDate}
  modifiedTime={post.data.updatedDate ?? post.data.pubDate}
  authorUrl={authorUrl}
  section={post.data.category}
  tags={post.data.tags}
>
  <article class="article">
    <header class="article-header">
      <div class="meta">
        <a class="pill" href={getCategoryPath(post.data.category)}>{post.data.category}</a>
        {post.data.contentType === "field-note" && <span class="record-type">현장 기록</span>}
        <a class="meta-author" href="/author" rel="author">작성 {post.data.author}</a>
        <span>게시 <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time></span>
        {post.data.updatedDate && (
          <span>수정 {formatDate(post.data.updatedDate)}</span>
        )}
        <span>{readingTime}분 읽기</span>
      </div>
      <h1 class="article-title">{post.data.title}</h1>
      <p class="lead">{post.data.description}</p>
      {post.data.heroImage && (
        <div class="article-image">
          <img
            src={post.data.heroImage}
            alt={heroImageAlt}
            width={heroImageSize?.width}
            height={heroImageSize?.height}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      )}
    </header>
    <aside class="content-basis" aria-label="이 글의 작성 기준">
      <strong>{post.data.contentType === "field-note" ? "직접 경험·기록 기반" : "공식 정보 확인형 가이드"}</strong>
      <span>
        {post.data.contentType === "field-note"
          ? "작성자가 직접 방문하거나 촬영한 경험의 범위를 구분해 기록합니다. 현재 운영 정보와 오래된 경험은 섞지 않습니다."
          : "정부·공식 관광기관·시설 운영 주체 등 확인 가능한 자료를 우선하고, 바뀔 수 있는 정보는 수정일과 출처를 함께 관리합니다."}
      </span>
      {post.data.contentType !== "field-note" && (
        <span class="content-basis-date">정보 기준 {formatDate(post.data.updatedDate ?? post.data.pubDate)}</span>
      )}
      <span class="content-basis-links">
        <a href="/author">운영자</a>
        <span aria-hidden="true">·</span>
        <a href="/editorial-policy">작성·수정 원칙</a>
      </span>
    </aside>
    {post.data.fieldNote && (
      <aside class="field-note-meta" aria-label="기록 범위">
        <strong>{post.data.fieldNote.label}</strong>
        <span>{post.data.fieldNote.disclaimer}</span>
      </aside>
    )}
    {post.data.map && (
      <PlaceMap
        title={post.data.map.title}
        query={post.data.map.query}
        address={post.data.map.address}
      />
    )}
    <div class="article-body">
      <slot />
    </div>
    {post.data.tags.length > 0 && (
      <div class="tag-list" aria-label="태그">
        {post.data.tags.map((tag) => <span>#{tag}</span>)}
      </div>
    )}
    <aside class="author-box" aria-label="작성자와 편집 기준">
      <div class="author-avatar" aria-hidden="true">AB</div>
      <div>
        <p class="author-label">WRITTEN BY</p>
        <h2><a href="/author">{post.data.author}</a></h2>
        <p>
          UAE의 장소와 생활을 기록합니다. 개인 기록과 공식 확인이 필요한 실용 정보를 구분하고,
          운영 시간·규정처럼 바뀔 수 있는 내용은 글 끝의 출처와 수정일을 함께 관리합니다.
        </p>
        <a href="/editorial-policy">작성·수정 원칙 보기</a>
      </div>
    </aside>
    <script type="application/ld+json" set:html={JSON.stringify(articleJson)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJson)} />
  </article>
  {relatedPosts.length > 0 && (
    <section class="section related-section" aria-labelledby="related-title">
      <div class="container">
        <div class="section-head">
          <div>
            <p class="eyebrow">KEEP READING</p>
            <h2 id="related-title">같이 읽기 좋은 글</h2>
          </div>
          <p>{post.data.category} 안에서 핵심 글과 태그가 가까운 기록을 우선해 이어서 보여 줍니다.</p>
        </div>
        <div class="post-grid compact-grid">
          {relatedPosts.map((item) => <PostCard post={item} />)}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .meta-author {
    color: inherit;
    font-weight: 800;
    text-decoration: none;
  }

  .meta-author:hover {
    text-decoration: underline;
  }

  .content-basis {
    display: grid;
    gap: 5px;
    margin: 0 0 24px;
    padding: 14px 16px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface-muted);
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.6;
  }

  .content-basis strong {
    color: var(--text);
  }

  .content-basis-date {
    color: var(--text);
    font-weight: 700;
  }

  .content-basis-links {
    display: flex;
    gap: 7px;
    align-items: center;
    margin-top: 2px;
  }

  .content-basis-links a {
    font-weight: 800;
  }
</style>
