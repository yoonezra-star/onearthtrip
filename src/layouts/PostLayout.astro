---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { getPosts } from "../utils/posts";
import { formatDate, getCategoryPath, getPublicPath, getReadingTime } from "../utils/posts";
import { site } from "../data/site";

type Props = {
  post: CollectionEntry<"posts">;
};

const { post } = Astro.props;
const title = `${post.data.title} | ${site.name}`;
const canonical = getPublicPath(post.data.permalink);
const readingTime = getReadingTime(post.body ?? "");
const canonicalUrl = new URL(canonical, site.url).toString();
const relatedPosts = (await getPosts())
  .filter((item) => item.id !== post.id && item.data.category === post.data.category)
  .slice(0, 3);
const articleJson = {
  "@context": "https://schema.org",
  "@type": "Article",
  "@id": `${canonicalUrl}#article`,
  url: canonicalUrl,
  headline: post.data.title,
  description: post.data.description,
  image: post.data.heroImage,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  author: {
    "@type": "Person",
    name: post.data.author,
    url: new URL("/author", site.url).toString()
  },
  publisher: {
    "@type": "Organization",
    "@id": `${site.url}#organization`,
    name: site.name
  },
  mainEntityOfPage: canonicalUrl,
  inLanguage: site.locale,
  isAccessibleForFree: true,
  articleSection: post.data.category
};
const breadcrumbJson = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "홈", item: site.url },
    {
      "@type": "ListItem",
      position: 2,
      name: post.data.category,
      item: new URL(getCategoryPath(post.data.category), site.url).toString()
    },
    { "@type": "ListItem", position: 3, name: post.data.title, item: canonicalUrl }
  ]
};
---

<BaseLayout
  title={title}
  description={post.data.description}
  image={post.data.heroImage}
  canonical={canonical}
  pageType="article"
>
  <article class="article">
    <header class="article-header">
      <div class="meta">
        <a class="pill" href={getCategoryPath(post.data.category)}>{post.data.category}</a>
        {post.data.contentType === "field-note" && <span class="record-type">현장 기록</span>}
        <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
        {post.data.updatedDate && (
          <span>수정 {formatDate(post.data.updatedDate)}</span>
        )}
        <span>{readingTime}분 읽기</span>
      </div>
      <h1 class="article-title">{post.data.title}</h1>
      <p class="lead">{post.data.description}</p>
      {post.data.heroImage && (
        <div class="article-image">
          <img src={post.data.heroImage} alt={post.data.title} />
        </div>
      )}
    </header>
    {post.data.fieldNote && (
      <aside class="field-note-meta" aria-label="기록 범위">
        <strong>{post.data.fieldNote.label}</strong>
        <span>{post.data.fieldNote.disclaimer}</span>
      </aside>
    )}
    <div class="article-body">
      <slot />
    </div>
    {post.data.tags.length > 0 && (
      <div class="tag-list" aria-label="태그">
        {post.data.tags.map((tag) => <span>#{tag}</span>)}
      </div>
    )}
    <aside class="author-box" aria-label="작성자와 편집 기준">
      <div class="author-avatar" aria-hidden="true">AB</div>
      <div>
        <p class="author-label">WRITTEN BY</p>
        <h2><a href="/author">{post.data.author}</a></h2>
        <p>
          UAE의 장소와 생활을 기록합니다. 개인 기록과 공식 확인이 필요한 실용 정보를 구분하고,
          운영 시간·규정처럼 바뀔 수 있는 내용은 글 끝의 출처와 수정일을 함께 관리합니다.
        </p>
        <a href="/editorial-policy">작성·수정 원칙 보기</a>
      </div>
    </aside>
    <script type="application/ld+json" set:html={JSON.stringify(articleJson)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJson)} />
  </article>
  {relatedPosts.length > 0 && (
    <section class="section related-section" aria-labelledby="related-title">
      <div class="container">
        <div class="section-head">
          <div>
            <p class="eyebrow">KEEP READING</p>
            <h2 id="related-title">같이 읽기 좋은 글</h2>
          </div>
          <p>{post.data.category} 주제의 다른 기록을 이어서 볼 수 있습니다.</p>
        </div>
        <div class="post-grid compact-grid">
          {relatedPosts.map((item) => <PostCard post={item} />)}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
