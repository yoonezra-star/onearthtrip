---
import "../styles/global.css";
import { nav, site } from "../data/site";

type Props = {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  pageType?: "website" | "article";
  publishedTime?: Date;
  modifiedTime?: Date;
  authorUrl?: string;
  section?: string;
  tags?: string[];
};

const {
  title = site.title,
  description = site.description,
  image,
  canonical = Astro.url.pathname,
  pageType = "website",
  publishedTime,
  modifiedTime,
  authorUrl,
  section,
  tags = []
} = Astro.props;

const canonicalPath = canonical
  .replace(/\/index\.html$/, "/")
  .replace(/\.html$/, "");
const canonicalUrl = new URL(canonicalPath, site.url).toString();
const imageUrl = image ? new URL(image, site.url).toString() : undefined;
const publishedTimeIso = publishedTime?.toISOString();
const modifiedTimeIso = modifiedTime?.toISOString();
const currentPath = Astro.url.pathname;
const normalizedCurrentPath = currentPath
  .replace(/\/index\.html$/, "/")
  .replace(/\.html$/, "")
  .replace(/\/$/, "") || "/";
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-site-verification" content="yN4Gmu9yXbLAe6jaCfFthWamFuz0K0zUr0gVon5mwfI" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:type" content={pageType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {pageType === "article" && publishedTimeIso && (
      <meta property="article:published_time" content={publishedTimeIso} />
    )}
    {pageType === "article" && modifiedTimeIso && (
      <meta property="article:modified_time" content={modifiedTimeIso} />
    )}
    {pageType === "article" && authorUrl && (
      <meta property="article:author" content={authorUrl} />
    )}
    {pageType === "article" && section && (
      <meta property="article:section" content={section} />
    )}
    {pageType === "article" && tags.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}
    <meta name="twitter:card" content={imageUrl ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    <script
      is:inline
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6918910185244897"
      crossorigin="anonymous"
    ></script>
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "@id": `${site.url}#website`,
      name: site.name,
      url: site.url,
      inLanguage: site.locale,
      description: site.description,
      publisher: { "@id": `${site.url}#organization` }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "@id": `${site.url}#organization`,
      name: site.name,
      url: site.url,
      email: site.email
    })} />
  </head>
  <body>
    <a class="skip-link" href="#content">본문으로 바로가기</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/" aria-label={`${site.name} 홈`}>
          <span class="brand-mark">OET</span>
          <span class="brand-copy">
            <strong>{site.name}</strong>
            <span>아부다비에서 살아보니 보이는 UAE</span>
          </span>
        </a>
        <nav class="nav" aria-label="주요 메뉴">
          {nav.map((item) => {
            const itemPath = item.href.replace(/\/$/, "") || "/";
            return (
              <a
                href={item.href}
                aria-current={normalizedCurrentPath === itemPath ? "page" : undefined}
              >
                {item.label}
              </a>
            );
          })}
        </nav>
        <a class="header-contact" href="/contact">
          문의
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </header>
    <main id="content">
      <slot />
    </main>
    <footer class="footer">
      <div class="container footer-inner">
        <p>© {new Date().getFullYear()} {site.name}. 개인 기록과 확인 가능한 공개 자료를 구분해 작성합니다.</p>
        <div class="footer-links">
          <a href="/reading-guide">읽기 길잡이</a>
          <a href="/field-notes">현장 기록 아카이브</a>
          <a href="/trip-checklist">여행 준비 체크</a>
          <a href="/author">운영자</a>
          <a href="/privacy">개인정보처리방침</a>
          <a href="/terms">이용약관</a>
          <a href="/editorial-policy">작성·수정 원칙</a>
          <a href="/contact">문의</a>
        </div>
      </div>
    </footer>
  </body>
</html>
