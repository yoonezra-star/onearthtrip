---
import "../styles/global.css";
import { nav, site } from "../data/site";
import { getPublicPath } from "../utils/posts";

type Props = {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  pageType?: "website" | "article";
  publishedTime?: Date;
  modifiedTime?: Date;
  authorUrl?: string;
  section?: string;
  tags?: string[];
  robots?: string;
  adsAllowed?: boolean;
};

const {
  title = site.title,
  description = site.description,
  image,
  canonical = Astro.url.pathname,
  pageType = "website",
  publishedTime,
  modifiedTime,
  authorUrl,
  section,
  tags = [],
  robots = "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1",
  adsAllowed: adsAllowedOverride
} = Astro.props;

const canonicalPath = getPublicPath(canonical);
const canonicalUrl = new URL(canonicalPath, site.url).toString();
const imageUrl = image ? new URL(image, site.url).toString() : undefined;
const publishedTimeIso = publishedTime?.toISOString();
const modifiedTimeIso = modifiedTime?.toISOString();
const normalizedCurrentPath = getPublicPath(Astro.url.pathname);
const adFreeUtilityPaths = new Set([
  "/search",
  "/404",
  "/contact",
  "/privacy",
  "/terms",
  "/about",
  "/author",
  "/editorial-policy"
]);
const adsAllowed = adsAllowedOverride ?? !adFreeUtilityPaths.has(normalizedCurrentPath);
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-site-verification" content="yN4Gmu9yXbLAe6jaCfFthWamFuz0K0zUr0gVon5mwfI" />
    <meta name="robots" content={robots} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:type" content={pageType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {pageType === "article" && publishedTimeIso && (
      <meta property="article:published_time" content={publishedTimeIso} />
    )}
    {pageType === "article" && modifiedTimeIso && (
      <meta property="article:modified_time" content={modifiedTimeIso} />
    )}
    {pageType === "article" && authorUrl && (
      <meta property="article:author" content={authorUrl} />
    )}
    {pageType === "article" && section && (
      <meta property="article:section" content={section} />
    )}
    {pageType === "article" && tags.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}
    <meta name="twitter:card" content={imageUrl ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    {adsAllowed && (
      <script
        is:inline
        async
        src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6918910185244897"
        crossorigin="anonymous"
      ></script>
    )}
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "@id": `${site.url}#website`,
      name: site.name,
      url: site.url,
      inLanguage: site.locale,
      description: site.description,
      publisher: { "@id": `${site.url}#organization` }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "@id": `${site.url}#organization`,
      name: site.name,
      url: site.url,
      email: site.email
    })} />
  </head>
  <body>
    <a class="skip-link" href="#content">본문으로 바로가기</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/" aria-label={`${site.name} 홈`}>
          <span class="brand-mark">OET</span>
          <span class="brand-copy">
            <strong>{site.name}</strong>
            <span>아부다비에서 살아보니 보이는 UAE</span>
          </span>
        </a>
        <nav class="nav" aria-label="주요 메뉴">
          {nav.map((item) => {
            const itemPath = getPublicPath(item.href);
            return (
              <a
                href={item.href}
                aria-current={normalizedCurrentPath === itemPath ? "page" : undefined}
              >
                {item.label}
              </a>
            );
          })}
        </nav>
        <div class="header-actions">
          <form class="header-search-form" role="search" action="/search" method="get">
            <label class="sr-only" for="header-search-input">사이트 검색</label>
            <input
              id="header-search-input"
              name="q"
              type="search"
              inputmode="search"
              autocomplete="off"
              placeholder="글 검색"
            />
            <button type="submit">검색</button>
          </form>
          <a class="header-contact" href="/contact">
            문의
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </header>
    <main id="content">
      <slot />
    </main>
    <footer class="footer">
      <div class="container footer-inner">
        <p>© {new Date().getFullYear()} {site.name}. 개인 기록과 확인 가능한 공개 자료를 구분해 작성합니다.</p>
        <div class="footer-links">
          <a href="/search">사이트 검색</a>
          <a href="/reading-guide">읽기 길잡이</a>
          <a href="/field-notes">현장 기록 아카이브</a>
          <a href="/trip-checklist">여행 준비 체크</a>
          <a href="/author">운영자</a>
          <a href="/privacy">개인정보처리방침</a>
          <a href="/terms">이용약관</a>
          <a href="/editorial-policy">작성·수정 원칙</a>
          <a href="/contact">문의</a>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  .sr-only {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
  }

  .header-actions {
    display: flex;
    min-width: max-content;
    align-items: center;
    gap: 8px;
  }

  .header-search-form {
    display: flex;
    align-items: center;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface);
  }

  .header-search-form input {
    width: 130px;
    min-height: 40px;
    border: 0;
    padding: 0 10px;
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: 0.88rem;
    outline: 0;
  }

  .header-search-form input::placeholder {
    color: var(--soft);
  }

  .header-search-form:focus-within {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(15, 118, 110, 0.12);
  }

  .header-search-form button {
    min-height: 40px;
    border: 0;
    border-left: 1px solid var(--line);
    padding: 0 11px;
    background: var(--surface-muted);
    color: var(--accent-strong);
    cursor: pointer;
    font: inherit;
    font-size: 0.84rem;
    font-weight: 900;
  }

  @media (max-width: 640px) {
    .header-actions {
      gap: 6px;
    }

    .header-search-form input {
      width: 86px;
      padding-inline: 8px;
    }

    .header-search-form button {
      padding-inline: 8px;
      font-size: 0.78rem;
    }
  }
</style>
